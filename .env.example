# 博客名称
SITE_TITLE=三十而立
SITE_SUBTITLE=记录·沉淀·回忆

# 博主信息
BLOG_AUTHOR=博主
BLOG_EMAIL=admin@example.com

# OpenList 存储配置
OPENLIST_API_URL=https://your-openlist-domain.com/api
OPENLIST_TOKEN=your-openlist-token-here

# AI 配置
AI_API_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key-here
AI_MODEL=deepseek-chat

# Cloudflare D1 数据库
# 在 Cloudflare Dashboard 创建后填入
# D1_DATABASE_ID=your-database-id-here

# JWT 密钥（生成随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 上传配置
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/*,application/pdf,application/zip,text/*

# 功能开关
ENABLE_AI=true
ENABLE_ANALYTICS=false
