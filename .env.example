# =============================================
# 岁月博客 - 环境变量配置
# =============================================

# Cloudflare Workers & Pages
# -------------------

# Cloudflare Account ID（用于 Workers AI）
# 在 Cloudflare Dashboard -> 右上角头像 -> 我的个人资料 -> 底部找到
CF_ACCOUNT_ID=

# D1 数据库 ID
# 在 Cloudflare Dashboard -> Workers & Pages -> D1 SQL Databases 创建
D1_DATABASE_ID=

# =============================================
# 站点配置
# -------------------

# 站点标题
SITE_TITLE=三十而立

# 站点副标题
SITE_SUBTITLE=记录·沉淀·回忆

# 站点描述
SITE_DESCRIPTION=一个记录生活与思考的个人博客

# 主人名字
OWNER_NAME=主人

# 主人签名
OWNER_SIGNATURE=主人敬上

# =============================================
# OpenList 文件存储
# -------------------
# 如果你没有搭建 OpenList，可以先留空

# OpenList API 地址（末尾不要带 /）
OPENLIST_API_URL=

# OpenList 认证 Token
OPENLIST_TOKEN=

# =============================================
# AI 服务（可选）
# -------------------
# 默认使用 Cloudflare Workers AI（推荐，免费）
# 如果 Cloudflare AI 不可用，可以使用第三方 API

# AI 提供商：cloudflare / deepseek / kimi / doubao
AI_PROVIDER=cloudflare

# AI API Key（Cloudflare 用 Account ID，其他用 API Key）
# Cloudflare: 填写 CF_ACCOUNT_ID 即可，不需要这里
AI_API_KEY=

# AI API Base URL（第三方 API 需要）
AI_BASE_URL=

# AI 模型（可选）
AI_MODEL=
