---
import '../styles/global.css';

interface Props {
  title: string;
  currentPage?: string;
}

const { title, currentPage = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
    <!-- 核心容器 -->
    <div class="book-container">
        <!-- 左侧栏（书脊） -->
        <aside class="sidebar">
            <!-- 上部：精神角落 -->
            <div class="sidebar-top">
                <div class="sidebar-title">
                    <h1>三十而立</h1>
                    <button class="login-seal" onclick="toggleLogin()" title="点击盖印">
                        主
                    </button>
                </div>
                
                <div class="sidebar-slogan">
                    <p>记录 · 沉淀 · 回忆</p>
                </div>

                <div class="sidebar-english">
                    <p>The Chronicle</p>
                </div>
            </div>

            <!-- 中部：导航菜单 -->
            <nav class="sidebar-nav">
                <ul>
                    <!-- 首页 -->
                    <li class:list={[{ active: currentPage === 'home' }]}>
                        <a href="/">
                            <i class="ph ph-house menu-icon"></i>
                            <span class="menu-item-text">博客首页</span>
                        </a>
                    </li>
                    
                    <!-- 岁月日志 -->
                    <li class:list={[{ active: currentPage === 'log' }]}>
                        <a href="/log">
                            <i class="ph ph-pen-nib menu-icon"></i>
                            <span class="menu-item-text">岁月日志</span>
                        </a>
                    </li>
                    
                    <!-- 生活相册 -->
                    <li class:list={[{ active: currentPage === 'album' }]}>
                        <a href="/album">
                            <i class="ph ph-image menu-icon"></i>
                            <span class="menu-item-text">生活相册</span>
                        </a>
                    </li>
                    
                    <!-- 个人网盘 -->
                    <li class:list={[{ active: currentPage === 'drive' }]}>
                        <a href="/drive">
                            <i class="ph ph-hard-drives menu-icon"></i>
                            <span class="menu-item-text">个人网盘</span>
                        </a>
                    </li>
                    
                    <!-- 常用导航 -->
                    <li class:list={[{ active: currentPage === 'nav' }]}>
                        <a href="/nav">
                            <i class="ph ph-compass menu-icon"></i>
                            <span class="menu-item-text">常用导航</span>
                        </a>
                    </li>
                    
                    <!-- 文章归档 -->
                    <li class:list={[{ active: currentPage === 'archive' }]}>
                        <a href="/archive">
                            <i class="ph ph-archive menu-icon"></i>
                            <span class="menu-item-text">文章归档</span>
                        </a>
                    </li>
                    
                    <!-- 访客留言 -->
                    <li class:list={[{ active: currentPage === 'guestbook' }]}>
                        <a href="/guestbook">
                            <i class="ph ph-envelope-simple menu-icon"></i>
                            <span class="menu-item-text">访客留言</span>
                        </a>
                    </li>

                    <!-- 分割线（需要登录才显示） -->
                    <li class="admin-menu" id="admin-divider"></li>

                    <!-- 我的待办（需要登录） -->
                    <li class="admin-menu" id="menu-todo">
                        <a href="/todo">
                            <i class="ph ph-check-square-offset menu-icon"></i>
                            <span class="menu-item-text">我的待办</span>
                        </a>
                    </li>
                    
                    <!-- 后台管理（需要登录） -->
                    <li class="admin-menu" id="menu-admin">
                        <a href="/admin">
                            <i class="ph ph-gear menu-icon"></i>
                            <span class="menu-item-text">后台管理</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- 底部：版权 -->
            <div class="sidebar-footer">
                <p>&copy; 2024 - 2064</p>
                <p>朝花夕拾 · 岁月静好</p>
            </div>
        </aside>

        <!-- 右侧内容区 -->
        <main class="content">
            <slot />
        </main>
    </div>

    <script is:inline>
        function toggleLogin() {
            const adminMenus = document.querySelectorAll('.admin-menu');
            const btn = document.querySelector('.login-seal');
            
            adminMenus.forEach(menu => {
                menu.classList.toggle('show');
            });

            if (btn.classList.contains('active')) {
                btn.classList.remove('active');
            } else {
                btn.classList.add('active');
            }
        }
    </script>
</body>
</html>
