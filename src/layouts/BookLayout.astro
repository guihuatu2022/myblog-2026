---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  sealChar?: string;
  sealRotate?: number;
}

const { title, subtitle = '', sealChar = '阅', sealRotate = 12 } = Astro.props;
---

<BaseLayout title={title}>
  <div class="book-container flex w-full max-w-[1200px] min-h-[90vh] shadow-2xl relative">
    <!-- 左侧书脊 -->
    <slot name="sidebar" />

    <!-- 右侧内容区 -->
    <main class="content flex-1 paper-texture book-shadow p-12 overflow-y-auto flex flex-col">
      <!-- 顶部标题栏 -->
      <header class="flex justify-between items-end border-b border-[#dcd3b2] pb-4 mb-8 shrink-0 relative">
        <div>
          <h2 class="text-3xl font-bold text-[#2c2c2c] mb-1 font-serif tracking-widest">{title}</h2>
          {subtitle && <p class="text-[#8b3a3a] text-sm tracking-widest font-serif">{subtitle}</p>}
        </div>
        <div class="text-right relative">
          <span class="text-4xl font-light text-[#cfcfcf] absolute top-0 right-0 select-none opacity-50 z-0 font-serif -translate-y-2 translate-x-4">
            {title}
          </span>
          <div 
            class="seal-stamp-lg z-10 relative"
            style={`transform: rotate(${sealRotate}deg); mix-blend-mode: multiply;`}
          >
            {sealChar}
          </div>
        </div>
      </header>

      <!-- 内容区 -->
      <div class="flex-grow">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
