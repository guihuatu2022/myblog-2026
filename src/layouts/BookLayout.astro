---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
}

const {
  title = '三十而立',
  description = '记录 · 沉淀 · 回忆',
  currentPage = 'home'
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="book-container">
    <!-- 左侧书脊 -->
    <Sidebar currentPage={currentPage} />

    <!-- 右侧内容区 -->
    <main class="content paper-texture book-shadow">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .book-container {
    display: flex;
    width: 100%;
    max-width: 1200px;
    min-height: 90vh;
    margin: 0 auto;
  }

  .content {
    flex: 1;
    padding: 3rem;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .book-container {
      flex-direction: column;
      max-width: 100%;
      min-height: auto;
    }

    .content {
      padding: 1.5rem;
      min-height: 70vh;
    }
  }
</style>
