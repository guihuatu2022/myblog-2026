---
import BookLayout from '../layouts/BookLayout.astro';

const timeline = [
  {
    year: '2024',
    months: [
      {
        month: '五月',
        posts: [
          { id: '1', title: '三十岁的第一个清晨', date: '05-20', category: '随笔' },
          { id: '2', title: '胶片里的老街', date: '05-18', category: '摄影' },
          { id: '3', title: '搭建博客的一些心得', date: '05-15', category: '技术' },
        ]
      },
      {
        month: '四月',
        posts: [
          { id: '9', title: '清明时节', date: '04-04', category: '随笔' },
        ]
      },
      {
        month: '三月',
        posts: [
          { id: '8', title: '春日骑行', date: '03-25', category: '生活' },
        ]
      },
    ]
  },
  {
    year: '2023',
    months: [
      {
        month: '十二月',
        posts: [
          { id: '9', title: '年终总结', date: '12-31', category: '随笔' },
          { id: '10', title: '冬至', date: '12-22', category: '生活' },
        ]
      },
    ]
  },
];
---

<BookLayout title="文章归档" currentPage="archive">
  <!-- 页眉 -->
  <header class="page-header">
    <div class="header-left">
      <h2 class="page-title">时光轴</h2>
      <p class="page-subtitle">记录走过的每一天</p>
    </div>
    <div class="header-right">
      <span class="page-header-bg">Archive</span>
      <div class="seal-stamp">纪</div>
    </div>
  </header>

  <!-- 时间线 -->
  <div class="timeline">
    {timeline.map(yearData => (
      <div class="year-section">
        <h3 class="year-title">{yearData.year}</h3>
        <div class="year-posts">
          {yearData.months.map(monthData => (
            <div class="month-group">
              <div class="month-label">
                <span class="month-name">{monthData.month}</span>
                <span class="month-count">{monthData.posts.length} 篇</span>
              </div>
              <div class="month-posts">
                {monthData.posts.map(post => (
                  <a href={`/log/${post.id}`} class="timeline-item">
                    <span class="item-date">{post.date}</span>
                    <span class="item-title">{post.title}</span>
                    <span class="item-category">{post.category}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</BookLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line-color);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .header-left {
    z-index: 1;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.25rem 0;
    font-family: var(--font-serif);
  }

  .page-subtitle {
    color: var(--text-light);
    font-size: 0.875rem;
    font-family: var(--font-serif);
  }

  .header-right {
    position: relative;
    z-index: 1;
  }

  .page-header-bg {
    font-size: 4rem;
    font-weight: 300;
    color: #cfcfcf;
    position: absolute;
    top: -1.5rem;
    right: 3.5rem;
    opacity: 0.3;
    user-select: none;
    font-family: var(--font-serif);
  }

  .seal-stamp {
    width: 48px;
    height: 48px;
    border: 2px solid var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: bold;
    transform: rotate(12deg);
    opacity: 0.7;
    font-family: var(--font-serif);
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line-color);
  }

  .year-section {
    margin-bottom: 2rem;
    position: relative;
  }

  .year-section::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 0.5rem;
    width: 10px;
    height: 10px;
    background: var(--accent-color);
    border-radius: 50%;
    transform: translateX(-4px);
  }

  .year-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-color);
    margin: 0 0 1.5rem 0;
    font-family: var(--font-serif);
  }

  .month-group {
    margin-bottom: 1.5rem;
  }

  .month-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .month-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-main);
    font-family: var(--font-serif);
  }

  .month-count {
    font-size: 0.75rem;
    color: var(--text-light);
    font-family: var(--font-serif);
  }

  .month-posts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--line-color);
    background: rgba(255,255,255,0.4);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .timeline-item:hover {
    background: white;
    border-color: var(--accent-color);
    padding-left: 1rem;
  }

  .timeline-item:hover .item-title {
    color: var(--accent-color);
  }

  .item-date {
    width: 45px;
    font-size: 0.8125rem;
    color: var(--text-light);
    font-family: var(--font-serif);
  }

  .item-title {
    flex: 1;
    font-size: 0.875rem;
    transition: color 0.2s ease;
    font-family: var(--font-serif);
  }

  .item-category {
    font-size: 0.75rem;
    color: var(--accent-color);
    opacity: 0.7;
    font-family: var(--font-serif);
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 1.5rem;
    }

    .timeline::before {
      left: -0.25rem;
    }

    .year-section::before {
      left: -1.75rem;
    }

    .item-category {
      display: none;
    }
  }
</style>
