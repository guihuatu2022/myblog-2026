---
import BookLayout from '../layouts/BookLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const currentPath = '/archive';

const archives = [
  {
    year: '2024',
    celestial: '甲辰年',
    volumes: [
      { month: '五月', count: 3, entries: ['三十岁的第一个清晨', '胶片里的老街', 'Astro博客搭建'] },
      { month: '四月', count: 5, entries: ['春游计划', '读书笔记', '生活感悟'] },
    ]
  },
  {
    year: '2023',
    celestial: '癸卯年',
    volumes: [
      { month: '十二月', count: 4, entries: ['年终总结', '旅行回忆'] },
      { month: '十一月', count: 3, entries: ['技术分享'] },
    ]
  },
  {
    year: '2022',
    celestial: '壬寅年',
    volumes: []
  }
];
---

<BookLayout title="岁月归档" subtitle="Archive" sealChar="档" sealRotate={-4}>
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 归档时间线 -->
  <div class="archive-timeline flex-1">
    {archives.map((yearData, yearIdx) => (
      <div class="year-block mb-12">
        <div class="flex items-center gap-4 mb-8">
          <div class="year-marker">
            <span class="year-num">{yearData.year}</span>
            <span class="celestial">{yearData.celestial}</span>
          </div>
          <div class="flex-1 h-px bg-gradient-to-r from-[#dcd3b2] to-transparent"></div>
        </div>

        <div class="volume-grid pl-4 border-l-2 border-[#dcd3b2] ml-4 space-y-6">
          {yearData.volumes.map((volume) => (
            <div class="volume-block">
              <div class="volume-header flex items-center gap-2 mb-3">
                <span class="month-tag">{volume.month}</span>
                <span class="text-xs text-[#8b3a3a]">({volume.count}篇)</span>
              </div>
              <ul class="entry-list space-y-2">
                {volume.entries.map(entry => (
                  <li class="entry-item">
                    <a href="#" class="text-[#5d5d5d] hover:text-[#8b3a3a] transition-colors text-sm flex items-center gap-2">
                      <i class="ph ph-file-text text-[#dcd3b2]"></i>
                      <span>{entry}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</BookLayout>

<style>
  .year-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 80px;
  }
  
  .year-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #2c2c2c;
    font-weight: bold;
  }
  
  .celestial {
    font-family: var(--font-hand);
    font-size: 0.8rem;
    color: #8b3a3a;
  }
  
  .month-tag {
    font-family: var(--font-hand);
    color: #2c2c2c;
    font-size: 1rem;
    padding: 2px 8px;
    border: 1px solid #dcd3b2;
    border-radius: 2px;
  }
  
  .volume-block {
    position: relative;
  }
  
  .entry-item a::before {
    content: '○';
    font-size: 0.5rem;
    transition: all 0.3s;
  }
  
  .entry-item a:hover::before {
    content: '●';
    color: #8b3a3a;
  }
</style>
