---
import BookLayout from '../../layouts/BookLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Pagination from '../../components/Pagination.astro';

const currentPage = 1;
const totalPages = 3;
const currentPath = '/log';
---

<BookLayout title="浮生六记" subtitle="Journal & Essays" sealChar="录" sealRotate={-6}>
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 分类索引 & 搜索 -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-dashed border-[#dcd3b2] text-sm text-[#5d5d5d] tracking-wider shrink-0" id="category-filters">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-bold text-[#2c2c2c] mr-2 font-serif">分类索引：</span>
      <span class="index-link active" data-filter="all">全部</span>
      <span class="text-[#dcd3b2] select-none">/</span>
      <span class="index-link" data-filter="随笔">生活随笔</span>
      <span class="text-[#dcd3b2] select-none">/</span>
      <span class="index-link" data-filter="技术">技术笔记</span>
      <span class="text-[#dcd3b2] select-none">/</span>
      <span class="index-link" data-filter="摄影">影像记忆</span>
    </div>
    <div class="relative group">
      <i class="ph ph-magnifying-glass absolute left-0 top-1/2 -translate-y-1/2 text-[#a8a8a8] group-focus-within:text-[#8b3a3a] transition-colors"></i>
      <input 
        type="text" 
        placeholder="检索往事..." 
        class="vintage-search pl-6"
        id="search-input"
      />
    </div>
  </div>

  <!-- 文章列表 -->
  <div id="journal-entries" class="flex-1">
    
    <!-- 卷三：2024 -->
    <details open class="mb-6 group year-section">
      <summary class="year-header flex items-center gap-3 text-xl font-bold text-[#2c2c2c] mb-6 select-none outline-none">
        <i class="ph ph-caret-right icon-arrow text-[#8b3a3a]"></i>
        <span>卷三 · 二零二四年</span>
        <span class="text-sm font-normal text-gray-500 mt-1">甲辰年</span>
        <span class="text-sm font-normal text-[#8b3a3a] opacity-70 mt-1 font-hand">(共 42 篇)</span>
      </summary>

      <div class="pl-4 border-l border-[#dcd3b2] ml-2 mt-4 space-y-4">
        
        <!-- 文章条目 -->
        <article class="entry-item border-b border-dashed border-[#dcd3b2] pb-4 last:border-b-0">
          <div class="flex items-baseline justify-between gap-4">
            <a href="/log/1" class="entry-title flex items-baseline gap-2 flex-1 group">
              <span class="text-[#8b3a3a] font-hand text-sm shrink-0">05-20</span>
              <h3 class="text-lg text-[#2c2c2c] group-hover:text-[#8b3a3a] transition-colors font-serif">
                三十岁的第一个清晨
              </h3>
            </a>
            <span class="category-tag">生活随笔</span>
          </div>
          <p class="text-sm text-gray-500 mt-2 ml-16 line-clamp-1">
            今天阳光很好，透过窗帘照在书桌上...
          </p>
        </article>

        <article class="entry-item border-b border-dashed border-[#dcd3b2] pb-4 last:border-b-0">
          <div class="flex items-baseline justify-between gap-4">
            <a href="/log/2" class="entry-title flex items-baseline gap-2 flex-1 group">
              <span class="text-[#8b3a3a] font-hand text-sm shrink-0">05-18</span>
              <h3 class="text-lg text-[#2c2c2c] group-hover:text-[#8b3a3a] transition-colors font-serif">
                胶片里的老街
              </h3>
            </a>
            <span class="category-tag">影像记忆</span>
          </div>
          <p class="text-sm text-gray-500 mt-2 ml-16 line-clamp-1">
            那个角落的咖啡店已经拆了...
          </p>
        </article>

        <article class="entry-item border-b border-dashed border-[#dcd3b2] pb-4 last:border-b-0">
          <div class="flex items-baseline justify-between gap-4">
            <a href="/log/3" class="entry-title flex items-baseline gap-2 flex-1 group">
              <span class="text-[#8b3a3a] font-hand text-sm shrink-0">05-15</span>
              <h3 class="text-lg text-[#2c2c2c] group-hover:text-[#8b3a3a] transition-colors font-serif">
                Astro 框架搭建博客心得
              </h3>
            </a>
            <span class="category-tag">技术笔记</span>
          </div>
          <p class="text-sm text-gray-500 mt-2 ml-16 line-clamp-1">
            用了整整一周时间，终于把博客搭好了...
          </p>
        </article>

        <article class="entry-item entry-private border-b border-dashed border-[#dcd3b2] pb-4 last:border-b-0">
          <div class="flex items-baseline justify-between gap-4">
            <a href="/log/4" class="entry-title flex items-baseline gap-2 flex-1 group">
              <span class="text-[#8b3a3a] font-hand text-sm shrink-0">05-10</span>
              <h3 class="text-lg text-[#2c2c2c] group-hover:text-[#8b3a3a] transition-colors font-serif">
                私密日记
              </h3>
            </a>
            <span class="category-tag">私人</span>
            <span class="text-gray-400 text-xs flex items-center gap-1">
              <i class="ph ph-lock-simple"></i>
              <span class="font-hand">私有</span>
            </span>
          </div>
          <p class="text-sm text-gray-500 mt-2 ml-16 line-clamp-1">
            这是一篇只有自己能看到的日记...
          </p>
        </article>

      </div>
    </details>

    <!-- 卷二：2023 -->
    <details class="mb-6 group year-section">
      <summary class="year-header flex items-center gap-3 text-xl font-bold text-[#2c2c2c] mb-6 select-none outline-none">
        <i class="ph ph-caret-right icon-arrow text-[#8b3a3a]"></i>
        <span>卷二 · 二零二三年</span>
        <span class="text-sm font-normal text-gray-500 mt-1">癸卯年</span>
        <span class="text-sm font-normal text-[#8b3a3a] opacity-70 mt-1 font-hand">(共 38 篇)</span>
      </summary>
      <div class="pl-4 border-l border-[#dcd3b2] ml-2 mt-4 space-y-4">
        <!-- 更多文章... -->
      </div>
    </details>

  </div>

  <!-- 分页 -->
  <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/log" />
</BookLayout>

<script is:inline>
  // 分类筛选
  document.querySelectorAll('#category-filters .index-link').forEach(link => {
    link.addEventListener('click', () => {
      document.querySelectorAll('#category-filters .index-link').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      
      const filter = link.dataset.filter;
      document.querySelectorAll('.entry-item').forEach(item => {
        if (filter === 'all' || item.dataset.category === filter) {
          item.classList.remove('filtered-out');
        } else {
          item.classList.add('filtered-out');
        }
      });
    });
  });

  // 搜索功能
  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    document.querySelectorAll('.entry-item').forEach(item => {
      const title = item.querySelector('h3')?.textContent.toLowerCase() || '';
      const content = item.querySelector('p')?.textContent.toLowerCase() || '';
      if (title.includes(query) || content.includes(query)) {
        item.classList.remove('filtered-out');
      } else {
        item.classList.add('filtered-out');
      }
    });
  });
</script>

<style>
  .entry-item {
    transition: opacity 0.3s;
  }
  
  .entry-item.filtered-out {
    display: none;
  }
  
  .entry-title h3 {
    font-weight: 400;
  }
</style>
