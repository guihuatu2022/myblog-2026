---
import BookLayout from '../../layouts/BookLayout.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;

// 模拟数据
const post = {
  id: '1',
  title: '三十岁的第一个清晨',
  category: '随笔',
  date: '2024年05月20日',
  weather: '晴',
  mood: '平静',
  content: `
    <p>三十岁的第一天，阳光很好。</p>
    <p>清晨六点半醒来，发现窗帘的缝隙里透进一道光，斜斜地落在书桌上。我没有立刻起床，而是就这样躺着，看那道光慢慢移动，从床脚爬到墙壁上，最后消失在墙角。</p>
    <p>这是三十年来第一次，我认真地观察阳光的变化。以前总是匆匆忙忙，起床，洗漱，上班，下班，睡觉。日复一日，年复一年。三十岁，好像是一个该停下来思考的年纪。</p>
    <h2>关于过去</h2>
    <p>二十岁的时候，我觉得三十岁很遥远。那时候以为三十岁应该有所成就，有房有车，有稳定的工作，有家庭。现实是，三十岁的我，仍然在这条路上摸索。</p>
    <p>但我不觉得这是失败。三十岁，我学会了和自己和解，学会了接受不完美的自己，学会了在平凡的生活中寻找意义。</p>
    <h2>关于现在</h2>
    <p>现在的生活很简单。每天上班，下班后写写字，看看书，偶尔和朋友聚聚。这样的生活，或许在别人眼里太过平淡，但我觉得刚刚好。</p>
    <p>三十岁，我终于明白，人生不是一场竞赛，不必和别人比较。每个人都有自己的节奏，找到适合自己的方式就好。</p>
    <blockquote>「人生就像一本书，傻瓜们走马观花似的随手翻阅它，聪明的人用心地阅读它。因为他知道这本书只能读一次。」—— 保罗·科埃略</blockquote>
    <h2>关于未来</h2>
    <p>三十岁以后，我想活得更随性一些。想做的事情就去做，想见的人就去见，想说的话就去说。不要等到老了才后悔。</p>
    <p>这个博客，就当作是给自己的一份礼物。记录生活，记录思考，记录那些值得记住的时光。等我老了，再回头看看这些文字，应该会很有感触吧。</p>
  `,
  views: 128,
};

const relatedPosts = [
  { id: '4', title: '关于写作这件事', date: '05-10' },
  { id: '5', title: '周末的午后', date: '05-05' },
];
---

<BookLayout title={post.title} currentPage="log">
  <!-- 页眉 -->
  <header class="article-header">
    <div class="header-meta">
      <span class="article-category">{post.category}</span>
      <span class="article-date">{post.date}</span>
    </div>
    <h1 class="article-title">{post.title}</h1>
    <div class="article-tags">
      <span class="tag">☀️ {post.weather}</span>
      <span class="tag">💭 {post.mood}</span>
      <span class="tag">👁️ {post.views} 次阅读</span>
    </div>
  </header>

  <!-- 文章内容 -->
  <article class="article-content prose-paper" set:html={post.content} />

  <!-- 分割线 -->
  <div class="article-divider">
    <span>· · ·</span>
  </div>

  <!-- 相关日志 -->
  <section class="related-section">
    <h3 class="section-title">相关日志</h3>
    <div class="related-list">
      {relatedPosts.map(p => (
        <a href={`/log/${p.id}`} class="related-item">
          <span class="related-title">{p.title}</span>
          <span class="related-date">{p.date}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 评论区 -->
  <section class="comments-section">
    <h3 class="section-title">访客留言</h3>
    <div class="comment-form">
      <input type="text" placeholder="您的称呼" class="input-paper comment-input" />
      <textarea placeholder="写下您的留言..." class="input-paper comment-textarea"></textarea>
      <button class="btn-paper">提交留言</button>
    </div>
    <div class="comments-list">
      <div class="comment-item">
        <div class="comment-meta">
          <span class="comment-author">路过的朋友</span>
          <span class="comment-date">2024.05.20</span>
        </div>
        <p class="comment-content">写得真好，三十岁正是人生新的起点，加油！</p>
      </div>
    </div>
  </section>
</BookLayout>

<style>
  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-color);
  }

  .header-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-serif);
  }

  .article-category {
    color: var(--accent-color);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .article-date {
    color: var(--text-light);
    font-size: 0.875rem;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 1rem 0;
    line-height: 1.3;
    font-family: var(--font-serif);
  }

  .article-tags {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8125rem;
    color: var(--text-light);
    font-family: var(--font-serif);
  }

  .article-content {
    font-size: 1rem;
    line-height: 2;
  }

  .article-content :global(p) {
    text-indent: 2em;
    margin-bottom: 1rem;
    font-family: var(--font-serif);
  }

  .article-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
    border-left: 4px solid var(--accent-color);
    padding-left: 0.75rem;
    color: var(--text-main);
    font-family: var(--font-serif);
  }

  .article-content :global(blockquote) {
    margin: 2rem 1rem;
    padding: 1rem 1.5rem;
    background-color: rgba(139, 58, 58, 0.05);
    border-left: 4px solid var(--accent-color);
    font-style: italic;
    color: var(--text-light);
  }

  .article-divider {
    text-align: center;
    margin: 3rem 0;
    color: var(--text-light);
    letter-spacing: 0.5em;
    font-size: 1.25rem;
  }

  .section-title {
    font-size: 1rem;
    font-weight: 700;
    border-left: 4px solid var(--accent-color);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
    color: var(--text-main);
    letter-spacing: 0.1em;
    font-family: var(--font-serif);
  }

  .related-section {
    margin-bottom: 2rem;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--line-color);
    background-color: rgba(255,255,255,0.3);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .related-item:hover {
    background-color: rgba(255,255,255,0.6);
    border-color: var(--accent-color);
  }

  .related-title {
    font-size: 0.875rem;
    font-family: var(--font-serif);
  }

  .related-date {
    font-size: 0.75rem;
    color: var(--text-light);
    font-family: var(--font-serif);
  }

  .comments-section {
    margin-top: 2rem;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .comment-input,
  .comment-textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--line-color);
    background-color: rgba(255,255,255,0.5);
    font-family: var(--font-serif);
    font-size: 0.875rem;
  }

  .comment-textarea {
    min-height: 100px;
    resize: vertical;
  }

  .comment-input:focus,
  .comment-textarea:focus {
    outline: none;
    border-color: var(--accent-color);
    background-color: white;
  }

  .btn-paper {
    align-self: flex-end;
    background-color: var(--accent-color);
    color: white;
    padding: 0.5rem 1.25rem;
    border: none;
    font-family: var(--font-serif);
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-paper:hover {
    background-color: #6b2a2a;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comment-item {
    padding: 1rem;
    border: 1px solid var(--line-color);
    background-color: rgba(255,255,255,0.3);
  }

  .comment-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .comment-author {
    font-weight: 600;
    color: var(--accent-color);
    font-size: 0.875rem;
    font-family: var(--font-serif);
  }

  .comment-date {
    font-size: 0.75rem;
    color: var(--text-light);
    font-family: var(--font-serif);
  }

  .comment-content {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    text-indent: 0;
    color: var(--text-main);
    font-family: var(--font-serif);
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 1.5rem;
    }
  }
</style>
