---
import BookLayout from '../../layouts/BookLayout.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;

const album = {
  id: '1',
  title: '杭州的春天',
  description: '西湖边的垂柳，断桥上的残雪，还有龙井茶山的清晨',
  date: '2024.03',
  photoCount: 24,
};

const photos = Array.from({ length: 12 }, (_, i) => ({
  id: i + 1,
  src: `https://picsum.photos/seed/photo${id}${i}/800/600`,
  caption: `照片 ${i + 1}`,
}));
---

<BookLayout title={album.title} currentPage="album">
  <!-- 返回按钮 -->
  <a href="/album" class="back-link">
    <span>← 返回相册</span>
  </a>

  <!-- 页眉 -->
  <header class="page-header">
    <div class="header-left">
      <h2 class="page-title">{album.title}</h2>
      <p class="page-desc">{album.description}</p>
      <div class="album-meta">
        <span>📅 {album.date}</span>
        <span>📷 {album.photoCount} 张照片</span>
      </div>
    </div>
    <div class="header-right">
      <span class="page-header-bg">Album</span>
    </div>
  </header>

  <!-- 照片网格 -->
  <div class="photos-grid">
    {photos.map(photo => (
      <div class="photo-item" onclick={`openLightbox('${photo.src}')`}>
        <img src={photo.src} alt={photo.caption} loading="lazy" />
        <div class="photo-overlay">
          <span>{photo.caption}</span>
        </div>
      </div>
    ))}
  </div>
</BookLayout>

<!-- 灯箱 -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
  <button class="lightbox-close">×</button>
  <img id="lightbox-img" src="" alt="" />
</div>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-color);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #6b2a2a;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line-color);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
    font-family: var(--font-serif);
  }

  .page-desc {
    color: var(--text-light);
    font-size: 0.875rem;
    margin: 0 0 0.75rem 0;
    max-width: 500px;
    font-family: var(--font-serif);
  }

  .album-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.8125rem;
    color: var(--accent-color);
    font-family: var(--font-serif);
  }

  .header-right {
    position: relative;
    z-index: 1;
  }

  .page-header-bg {
    font-size: 4rem;
    font-weight: 300;
    color: #cfcfcf;
    position: absolute;
    top: -1.5rem;
    right: 0;
    opacity: 0.3;
    user-select: none;
    font-family: var(--font-serif);
  }

  .photos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .photos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .photo-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 4/3;
    border: 1px solid var(--line-color);
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .photo-item:hover img {
    transform: scale(1.1);
  }

  .photo-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.6));
    padding: 2rem 0.75rem 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .photo-item:hover .photo-overlay {
    opacity: 1;
  }

  .photo-overlay span {
    color: white;
    font-size: 0.75rem;
    font-family: var(--font-serif);
  }

  /* 灯箱样式 */
  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.9);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 2rem;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
  }
</style>

<script>
  function openLightbox(src) {
    const lightbox = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    if (lightbox && img) {
      img.src = src;
      lightbox.classList.add('active');
    }
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    if (lightbox) {
      lightbox.classList.remove('active');
    }
  }

  (window as any).openLightbox = openLightbox;
  (window as any).closeLightbox = closeLightbox;
</script>
