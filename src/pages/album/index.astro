---
import BookLayout from '../../layouts/BookLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Pagination from '../../components/Pagination.astro';

const currentPage = 1;
const totalPages = 1;
const currentPath = '/album';

const categories = ['全部', '旅行足迹', '生活随拍', '光影风景'];

const albums = [
  {
    id: 1,
    title: '晨光熹微',
    category: 'scenery',
    date: '2024.01',
    count: 24,
    cover: 'https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?q=80&w=600',
    rotation: 2,
    tapeColor: 'tape-blue'
  },
  {
    id: 2,
    title: '五渔村的夏天',
    category: 'travel',
    date: '2023.08',
    count: 36,
    cover: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600',
    rotation: -1.5,
    tapeColor: 'tape-red'
  },
  {
    id: 3,
    title: '日常碎片',
    category: 'life',
    date: '2023.06',
    count: 18,
    cover: 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=600',
    rotation: 1,
    tapeColor: 'tape-blue'
  }
];
---

<BookLayout title="光影流年" subtitle="Captured Memories" sealChar="影" sealRotate={3}>
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 分类索引 & 搜索 -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-dashed border-[#dcd3b2] text-sm text-[#5d5d5d] tracking-wider shrink-0" id="album-filters">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-bold text-[#2c2c2c] mr-2 font-serif">相册分类：</span>
      {categories.map((cat, idx) => (
        <>
          <span 
            class={`index-link ${idx === 0 ? 'active' : ''}`}
            data-filter={idx === 0 ? 'all' : cat}
          >
            {cat}
          </span>
          {idx < categories.length - 1 && <span class="text-[#dcd3b2] select-none">/</span>}
        </>
      ))}
    </div>
    <div class="relative group">
      <i class="ph ph-magnifying-glass absolute left-0 top-1/2 -translate-y-1/2 text-[#a8a8a8] group-focus-within:text-[#8b3a3a] transition-colors"></i>
      <input 
        type="text" 
        placeholder="检索回忆..." 
        class="vintage-search pl-6"
        id="search-input"
      />
    </div>
  </div>

  <!-- 瀑布流相册 -->
  <div id="album-volumes" class="flex-1">
    
    <!-- 卷三：2024 -->
    <details open class="mb-8 group year-section">
      <summary class="year-header flex items-center gap-3 text-xl font-bold text-[#2c2c2c] mb-6 select-none outline-none">
        <i class="ph ph-caret-right icon-arrow text-[#8b3a3a]"></i>
        <span>卷三 · 二零二四年</span>
        <span class="text-sm font-normal text-gray-500 mt-1">甲辰年</span>
      </summary>

      <div class="pl-4 border-l border-[#dcd3b2] ml-2 mt-4">
        <div class="masonry-grid">
          {albums.map(album => (
            <a 
              href={`/album/${album.id}`}
              class="album-card"
              style={`transform: rotate(${album.rotation}deg);`}
              data-category={album.category}
            >
              <div class={`tape ${album.tapeColor}`}></div>
              <div class="overflow-hidden aspect-square bg-gray-100 mb-2">
                <img 
                  src={album.cover}
                  alt={album.title}
                  class="w-full h-full object-cover sepia hover:sepia-0 transition-all duration-700"
                  loading="lazy"
                />
              </div>
              <div class="album-info">
                <h3 class="album-title">{album.title}</h3>
                <div class="album-meta">
                  <span>{album.date}</span>
                  <span>·</span>
                  <span>共 {album.count} 张</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </details>

  </div>

  <!-- 分页 -->
  <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/album" />
</BookLayout>

<script is:inline>
  // 分类筛选
  document.querySelectorAll('#album-filters .index-link').forEach(link => {
    link.addEventListener('click', () => {
      document.querySelectorAll('#album-filters .index-link').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      
      const filter = link.dataset.filter;
      
      document.querySelectorAll('.album-card').forEach(card => {
        if (filter === 'all' || card.dataset.category === filter) {
          card.classList.remove('filtered-out');
        } else {
          card.classList.add('filtered-out');
        }
      });
    });
  });

  // 搜索功能
  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    document.querySelectorAll('.album-card').forEach(card => {
      const title = card.querySelector('h3')?.textContent.toLowerCase() || '';
      if (title.includes(query)) {
        card.classList.remove('filtered-out');
      } else {
        card.classList.add('filtered-out');
      }
    });
  });
</script>

<style>
  .album-card.filtered-out {
    display: none;
  }
</style>
