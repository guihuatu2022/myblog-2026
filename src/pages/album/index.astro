---
import BookLayout from '../../layouts/BookLayout.astro';
import Pagination from '../../components/Pagination.astro';

const categories = [
  { name: '全部', count: 8 },
  { name: '风景', count: 3 },
  { name: '人文', count: 2 },
  { name: '静物', count: 2 },
  { name: '旅行', count: 1 },
];

const albums = [
  { id: '1', title: '五渔村的夏天', description: '意大利五渔村的彩色房子', cover: 'https://picsum.photos/seed/album1/600/400', category: '旅行', photoCount: 48, date: '2024-05-01', permission: 'public' },
  { id: '2', title: '城市角落', description: '在熟悉的城市里寻找不熟悉的角落', cover: 'https://picsum.photos/seed/album2/600/400', category: '人文', photoCount: 36, date: '2024-04-15', permission: 'public' },
  { id: '3', title: '老街时光', description: '那些即将消失的老街，用镜头留下最后的记忆', cover: 'https://picsum.photos/seed/album3/600/400', category: '人文', photoCount: 52, date: '2024-04-01', permission: 'public' },
  { id: '4', title: '春日花语', description: '春天来了，花都开了', cover: 'https://picsum.photos/seed/album4/600/400', category: '风景', photoCount: 28, date: '2024-03-20', permission: 'public' },
  { id: '5', title: '海边日落', description: '记录每一个温柔的黄昏', cover: 'https://picsum.photos/seed/album5/600/400', category: '风景', photoCount: 24, date: '2024-03-01', permission: 'public' },
  { id: '6', title: '咖啡馆日常', description: '喜欢在咖啡馆里发呆', cover: 'https://picsum.photos/seed/album6/600/400', category: '静物', photoCount: 18, date: '2024-02-15', permission: 'encrypted' },
];
---

<BookLayout title="生活相册">
  <div class="flex justify-between items-end mb-6 pb-4 border-b border-[#dcd3b2]">
    <div>
      <h2 class="text-3xl font-bold font-serif text-[#2c2c2c]">生活相册</h2>
      <p class="text-sm font-hand text-[#8b3a3a]">存于 D1 · 定格瞬间</p>
    </div>
    <div class="text-sm font-hand text-[#8b7355]">共 {albums.length} 个相册</div>
  </div>

  <div class="filter-bar">
    <div class="flex items-center gap-2">
      <span class="text-xs text-[#999] font-serif">分类</span>
      {categories.map((cat, i) => (
        <span class={`index-link ${i === 0 ? 'active' : ''}`}>
          {cat.name}
          <span class="text-[10px] text-[#bbb] ml-1">({cat.count})</span>
        </span>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {albums.map((album) => (
      <a href={`/album/${album.id}`} class="stat-card group hover:shadow-lg transition-all">
        <div class="relative -mx-6 -mt-6 mb-4 overflow-hidden rounded-t-lg">
          <img src={album.cover} alt={album.title} class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-110" />
          <div class="absolute bottom-3 right-3 bg-black/60 text-white px-3 py-1 rounded-full text-xs font-hand">
            {album.photoCount} 张
          </div>
          {album.permission === 'encrypted' && (
            <div class="absolute top-3 right-3">
              <span class="bg-black/60 text-white px-2 py-1 rounded text-xs">私密</span>
            </div>
          )}
        </div>
        <h3 class="font-serif font-bold text-lg text-[#2c2c2c] group-hover:text-[#8b3a3a] mb-2">{album.title}</h3>
        <p class="text-sm text-[#666] font-hand line-clamp-2">{album.description}</p>
        <div class="flex justify-between items-center mt-4 pt-3 border-t border-[#e8e0d0]">
          <span class="tag tag-green text-xs">{album.category}</span>
          <span class="text-xs font-hand text-[#999]">{album.date}</span>
        </div>
      </a>
    ))}
  </div>

  <div class="pagination">
    <span class="pagination-link disabled">上一页</span>
    <span class="pagination-link active">【壹】</span>
    <span class="pagination-link disabled">下一页</span>
  </div>

  <footer class="mt-10 pt-6 border-t border-[#dcd3b2] text-center">
    <p class="text-sm font-hand text-[#8b7355]">朝花夕拾 · 岁月静好</p>
  </footer>
</BookLayout>
