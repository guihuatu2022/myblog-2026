---
import BookLayout from '../layouts/BookLayout.astro';

// 模拟数据 - 后续从数据库获取
const recentPosts = [
  {
    title: '三十岁的第一个清晨',
    date: '2024.05.20',
    category: '岁月日志',
    excerpt: '今天阳光很好，透过窗帘照在书桌上。我想是时候整理一下过去十年的照片了...'
  },
  {
    title: '胶片里的老街',
    date: '2024.05.18',
    category: '影像回忆',
    excerpt: '那个角落的咖啡店已经拆了，幸好我留下了这张照片。城市的变迁总是让人猝不及防...'
  }
];
---

<BookLayout title="博客首页 - 三十而立" currentPage="home">
    <!-- 顶部日期/天气栏 -->
    <header class="content-header">
        <div>
            <h2>二零二四年</h2>
            <p class="subtitle">农历 甲辰年 十月廿三</p>
        </div>
        <div class="seal-decoration">
            <span class="page-label">Home</span>
            <div class="seal">阅</div>
        </div>
    </header>

    <!-- 首页内容 -->
    <article>
        <div class="welcome-text">
            <p>
                欢迎来到我的数字庭院。
            </p>
            <p>
                这里没有算法推荐，没有红点通知，只有我三十岁以后的生活琐碎。我把这里当作一本泛黄的旧书，希望当你偶然翻开时，能闻到一点时间的味道。
            </p>
            <p class="epigraph">—— 题记</p>
        </div>

        <!-- 最新动态 -->
        <h3 class="section-title">最近翻阅</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {recentPosts.map((post) => (
                <a href={`/log/${post.title}`} class="article-card">
                    <div class="article-meta">
                        {post.date} · {post.category}
                    </div>
                    <h4>{post.title}</h4>
                    <p>{post.excerpt}</p>
                </a>
            ))}
        </div>
    </article>
</BookLayout>
