---
import BookLayout from '../layouts/BookLayout.astro';

// 模拟数据 - 后续从数据库获取
const recentPosts = [
  {
    id: '1',
    title: '三十岁的第一个清晨',
    excerpt: '窗外的第一缕阳光透过窗帘的缝隙，在墙上投下一道金色的光痕。我躺在床上，听着远处隐约的鸟鸣，感受着这个与往常不同的早晨...',
    category: '随笔',
    date: '2024-05-20',
    cover: 'https://picsum.photos/seed/1/400/300',
    permission: 'public',
  },
  {
    id: '2',
    title: '胶片里的老街',
    excerpt: '那条老街还没拆的时候，我总爱在下午三四点的光景去走走。阳光斜斜地打在斑驳的墙面上，像是给岁月镀了一层金边...',
    category: '摄影',
    date: '2024-05-18',
    cover: 'https://picsum.photos/seed/2/400/300',
    permission: 'public',
  },
  {
    id: '3',
    title: '搭建博客的一些心得',
    excerpt: '花了将近一个月的空闲时间，终于把这个博客从零开始搭建完成。选择 Astro 作为框架，部署在 Cloudflare Pages 上...',
    category: '技术',
    date: '2024-05-15',
    cover: 'https://picsum.photos/seed/3/400/300',
    permission: 'public',
  },
];

const stats = {
  posts: 42,
  albums: 8,
  files: 127,
  days: 365,
};

const hostMessage = {
  content: '来者皆是客，不必拘礼。\n留下一言半语，便是缘分。',
  signature: '—— 主人敬上',
};
---

<BookLayout title="三十而立 - 首页">
  <!-- 年份标题 -->
  <div class="mb-8">
    <h2 class="text-4xl md:text-5xl font-bold font-serif text-[#2c2c2c] mb-2">
      二零二四年
    </h2>
    <p class="text-lg font-hand text-[#8b3a3a]">
      农历甲辰年 · 岁月如歌
    </p>
  </div>

  <!-- 欢迎语卡片 -->
  <div class="stat-card card-highlight mb-8">
    <div class="flex justify-between items-start">
      <div class="flex-1">
        <p class="font-hand text-[#5d5d5d] text-base leading-relaxed whitespace-pre-line">
          {hostMessage.content}
        </p>
        <p class="text-right font-calligraphy text-[#8b3a3a] mt-3">
          {hostMessage.signature}
        </p>
      </div>
    </div>
  </div>

  <!-- 快捷入口 -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
    <a href="/log" class="stat-card text-center hover:shadow-md transition-shadow group">
      <i class="ph ph-pen-nib text-3xl text-[#8b3a3a] mb-2 block"></i>
      <span class="font-serif text-sm group-hover:text-[#8b3a3a] transition-colors">岁月日志</span>
    </a>
    <a href="/album" class="stat-card text-center hover:shadow-md transition-shadow group">
      <i class="ph ph-images text-3xl text-[#8b3a3a] mb-2 block"></i>
      <span class="font-serif text-sm group-hover:text-[#8b3a3a] transition-colors">生活相册</span>
    </a>
    <a href="/drive" class="stat-card text-center hover:shadow-md transition-shadow group">
      <i class="ph ph-hard-drives text-3xl text-[#8b3a3a] mb-2 block"></i>
      <span class="font-serif text-sm group-hover:text-[#8b3a3a] transition-colors">个人网盘</span>
    </a>
    <a href="/nav" class="stat-card text-center hover:shadow-md transition-shadow group">
      <i class="ph ph-compass text-3xl text-[#8b3a3a] mb-2 block"></i>
      <span class="font-serif text-sm group-hover:text-[#8b3a3a] transition-colors">常用导航</span>
    </a>
  </div>

  <!-- 最近翻阅 -->
  <section class="mb-10">
    <h3 class="text-2xl font-serif font-bold text-[#2c2c2c] mb-6 flex items-center gap-3">
      <i class="ph ph-book-open text-[#8b3a3a]"></i>
      最近翻阅
    </h3>
    
    <div class="grid md:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <a href={`/log/${post.id}`} class="stat-card hover:shadow-lg transition-all group">
          {post.cover && (
            <div class="relative -mx-6 -mt-6 mb-4 overflow-hidden rounded-t-md">
              <img 
                src={post.cover} 
                alt={post.title}
                class="w-full h-40 object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
          )}
          <div class="flex items-center gap-2 mb-2">
            <span class="tag tag-red text-xs">{post.category}</span>
            {post.permission === 'encrypted' && (
              <span class="tag tag-gray text-xs">
                <i class="ph ph-lock-simple mr-1"></i>
                加密
              </span>
            )}
          </div>
          <h4 class="font-serif font-bold text-lg text-[#2c2c2c] mb-2 group-hover:text-[#8b3a3a] transition-colors line-clamp-2">
            {post.title}
          </h4>
          <p class="font-hand text-sm text-[#5d5d5d] line-clamp-3 mb-3">
            {post.excerpt}
          </p>
          <p class="text-xs text-[#999] font-hand">
            {post.date}
          </p>
        </a>
      ))}
    </div>
    
    <div class="text-center mt-6">
      <a href="/log" class="btn btn-outline">
        <i class="ph ph-article mr-1"></i>
        查看全部日志
      </a>
    </div>
  </section>

  <!-- 统计信息 -->
  <section class="stat-card">
    <h3 class="text-lg font-serif font-bold text-[#2c2c2c] mb-4">站点统计</h3>
    <div class="grid grid-cols-4 gap-4 text-center">
      <div>
        <p class="text-3xl font-bold font-calligraphy text-[#8b3a3a]">{stats.posts}</p>
        <p class="text-sm font-hand text-[#5d5d5d]">篇日志</p>
      </div>
      <div>
        <p class="text-3xl font-bold font-calligraphy text-[#8b3a3a]">{stats.albums}</p>
        <p class="text-sm font-hand text-[#5d5d5d]">个相册</p>
      </div>
      <div>
        <p class="text-3xl font-bold font-calligraphy text-[#8b3a3a]">{stats.files}</p>
        <p class="text-sm font-hand text-[#5d5d5d]">份资料</p>
      </div>
      <div>
        <p class="text-3xl font-bold font-calligraphy text-[#8b3a3a]">{stats.days}</p>
        <p class="text-sm font-hand text-[#5d5d5d]">个日夜</p>
      </div>
    </div>
  </section>

  <!-- 底部信息 -->
  <footer class="mt-10 pt-6 border-t border-[#dcd3b2] text-center">
    <p class="text-sm font-hand text-[#8b7355]">
      <i class="ph ph-heart text-[#8b3a3a] mr-1"></i>
      朝花夕拾 · 岁月静好
    </p>
  </footer>
</BookLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
