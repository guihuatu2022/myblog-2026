---
import BookLayout from '../layouts/BookLayout.astro';
import Sidebar from '../components/Sidebar.astro';

// 模拟数据
const recentPosts = [
  {
    title: '三十岁的第一个清晨',
    category: '岁月日志',
    date: '2024.05.20',
    excerpt: '今天阳光很好，透过窗帘照在书桌上。我想是时候整理一下过去十年的照片了...',
    url: '/log/1'
  },
  {
    title: '胶片里的老街',
    category: '影像回忆',
    date: '2024.05.18',
    excerpt: '那个角落的咖啡店已经拆了，幸好我留下了这张照片。城市的变迁总是让人猝不及防...',
    url: '/log/2'
  }
];

const currentPath = '/';
---

<BookLayout title="二零二四年" subtitle="农历 甲辰年 十月廿三">
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 首页内容 -->
  <article class="prose-vintage max-w-none text-lg">
    <div class="mb-12">
      <p class="leading-loose text-[#333] indent-8">
        欢迎来到我的数字庭院。
      </p>
      <p class="leading-loose text-[#333] indent-8 mt-4">
        这里没有算法推荐，没有红点通知，只有我三十岁以后的生活琐碎。我把这里当作一本泛黄的旧书，希望当你偶然翻开时，能闻到一点时间的味道。
      </p>
      <p class="leading-loose text-[#333] indent-8 mt-4">
        <span class="text-[#8b3a3a] text-sm block mt-2 text-right opacity-80 font-hand">—— 题记</span>
      </p>
    </div>

    <!-- 最新动态 -->
    <h3 class="text-lg font-bold border-l-4 border-[#8b3a3a] pl-3 mb-6 text-[#2c2c2c] tracking-widest font-serif">
      最近翻阅
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {recentPosts.map(post => (
        <a 
          href={post.url}
          class="article-card group hover:shadow-md"
        >
          <div class="text-xs text-[#8b3a3a] mb-2 font-bold tracking-wider opacity-70 font-serif">
            {post.date} · {post.category}
          </div>
          <h4 class="text-xl font-bold mb-3 text-[#2c2c2c] group-hover:text-[#8b3a3a] transition-colors font-serif">
            {post.title}
          </h4>
          <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
            {post.excerpt}
          </p>
        </a>
      ))}
    </div>

    <!-- 快捷入口 -->
    <h3 class="text-lg font-bold border-l-4 border-[#8b3a3a] pl-3 mb-6 mt-12 text-[#2c2c2c] tracking-widest font-serif">
      快速翻阅
    </h3>
    <div class="flex flex-wrap gap-4">
      <a href="/log" class="px-4 py-2 border border-[#dcd3b2] bg-white/40 hover:bg-[#fdfbf6] transition-all font-hand text-[#5d5d5d] hover:text-[#8b3a3a]">
        📝 岁月日志
      </a>
      <a href="/album" class="px-4 py-2 border border-[#dcd3b2] bg-white/40 hover:bg-[#fdfbf6] transition-all font-hand text-[#5d5d5d] hover:text-[#8b3a3a]">
        📷 生活相册
      </a>
      <a href="/drive" class="px-4 py-2 border border-[#dcd3b2] bg-white/40 hover:bg-[#fdfbf6] transition-all font-hand text-[#5d5d5d] hover:text-[#8b3a3a]">
        💾 个人网盘
      </a>
      <a href="/nav" class="px-4 py-2 border border-[#dcd3b2] bg-white/40 hover:bg-[#fdfbf6] transition-all font-hand text-[#5d5d5d] hover:text-[#8b3a3a]">
        🔗 常用导航
      </a>
    </div>
  </article>
</BookLayout>
