---
import BookLayout from '../../layouts/BookLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const currentPath = '/drive';

const categories = [
  { id: 'all', name: '全部文件' },
  { id: 'docs', name: '文档资料' },
  { id: 'code', name: '代码项目' },
  { id: 'design', name: '设计素材' },
  { id: 'other', name: '其他' }
];

const files = [
  {
    id: 1,
    name: '2024年度计划.pdf',
    size: '2.3MB',
    type: 'docs',
    date: '2024-01-05',
    download: 128
  },
  {
    id: 2,
    name: '博客源码.zip',
    size: '15.8MB',
    type: 'code',
    date: '2024-05-20',
    download: 256
  },
  {
    id: 3,
    name: '旅行照片集.zip',
    size: '128.5MB',
    type: 'design',
    date: '2024-04-15',
    download: 89
  },
  {
    id: 4,
    name: '阅读书单.md',
    size: '12KB',
    type: 'docs',
    date: '2024-03-20',
    download: 64
  }
];
---

<BookLayout title="个人网盘" subtitle="My Drive" sealChar="盘" sealRotate={-3}>
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 分类筛选 -->
  <div class="flex items-center gap-4 mb-8 pb-6 border-b border-dashed border-[#dcd3b2] shrink-0">
    <span class="font-bold text-[#2c2c2c] font-serif">文件分类：</span>
    <div class="flex flex-wrap gap-2">
      {categories.map((cat, idx) => (
        <button 
          class={`category-btn ${idx === 0 ? 'active' : ''}`}
          data-filter={cat.id}
        >
          {cat.name}
        </button>
      ))}
    </div>
  </div>

  <!-- 文件列表 -->
  <div class="file-list flex-1">
    <table class="w-full">
      <thead>
        <tr class="border-b border-[#dcd3b2]">
          <th class="text-left py-3 px-4 text-sm font-medium text-[#5d5d5d]">文件名</th>
          <th class="text-left py-3 px-4 text-sm font-medium text-[#5d5d5d] w-24">大小</th>
          <th class="text-left py-3 px-4 text-sm font-medium text-[#5d5d5d] w-28">日期</th>
          <th class="text-left py-3 px-4 text-sm font-medium text-[#5d5d5d] w-20">下载</th>
        </tr>
      </thead>
      <tbody>
        {files.map(file => (
          <tr 
            class="file-row border-b border-dashed border-[#dcd3b2] hover:bg-[#f7f1e3]/50 transition-colors"
            data-type={file.type}
          >
            <td class="py-3 px-4">
              <a href="#" class="flex items-center gap-3 group">
                <i class={`${getFileIcon(file.type)} text-xl text-[#8b3a3a]`}></i>
                <span class="text-[#2c2c2c] group-hover:text-[#8b3a3a] transition-colors">
                  {file.name}
                </span>
              </a>
            </td>
            <td class="py-3 px-4 text-sm text-[#888]">{file.size}</td>
            <td class="py-3 px-4 text-sm text-[#888]">{file.date}</td>
            <td class="py-3 px-4">
              <span class="text-sm text-[#8b3a3a]">{file.download}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BookLayout>

<script is:inline>
  // 分类筛选
  document.querySelectorAll('.category-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const filter = btn.dataset.filter;
      
      document.querySelectorAll('.file-row').forEach(row => {
        if (filter === 'all' || row.dataset.type === filter) {
          row.classList.remove('filtered-out');
        } else {
          row.classList.add('filtered-out');
        }
      });
    });
  });
</script>

<style>
  .file-row.filtered-out {
    display: none;
  }
  
  .category-btn {
    font-family: var(--font-hand);
    padding: 4px 12px;
    border: 1px solid #dcd3b2;
    border-radius: 2px;
    font-size: 0.9rem;
    color: #5d5d5d;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .category-btn:hover {
    border-color: #8b3a3a;
    color: #8b3a3a;
  }
  
  .category-btn.active {
    background: #8b3a3a;
    border-color: #8b3a3a;
    color: #fff;
  }
</style>

<Fragment set:html={`
<script is:inline>
  function getFileIcon(type) {
    const icons = {
      'docs': 'ph ph-file-text',
      'code': 'ph ph-file-code',
      'design': 'ph ph-image',
      'other': 'ph ph-file'
    };
    return icons[type] || 'ph ph-file';
  }
</script>
`}>