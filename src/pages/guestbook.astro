---
import BookLayout from '../layouts/BookLayout.astro';

const hostMessage = {
  content: '感谢每一位访客，愿你的生活也如这本小册子般，记录着美好与温暖。',
  signature: '—— 三十而立的主人',
};

const messages = [
  {
    id: '1',
    user: '路过的旅人',
    content: '偶然发现这个博客，设计很独特，内容也很温暖。祝好！',
    date: '2024.05.18',
    isPrivate: false,
  },
  {
    id: '2',
    user: '小明',
    content: '三十岁，正是好时候。加油！',
    date: '2024.05.15',
    isPrivate: false,
  },
  {
    id: '3',
    user: '匿名',
    content: '悄悄话...',
    date: '2024.05.10',
    isPrivate: true,
  },
];
---

<BookLayout title="访客留言" currentPage="guestbook">
  <!-- 页眉 -->
  <header class="page-header">
    <div class="header-left">
      <h2 class="page-title">留言板</h2>
      <p class="page-subtitle">留下你的足迹</p>
    </div>
    <div class="header-right">
      <span class="page-header-bg">Guestbook</span>
      <div class="seal-stamp">留</div>
    </div>
  </header>

  <!-- 主人寄语 -->
  <section class="host-section">
    <div class="host-card">
      <p class="host-label">主人寄语</p>
      <p class="host-content">"{hostMessage.content}"</p>
      <p class="host-signature">{hostMessage.signature}</p>
    </div>
  </section>

  <!-- 留言表单 -->
  <section class="form-section">
    <h3 class="section-title">写留言</h3>
    <form class="message-form">
      <div class="form-row">
        <input type="text" placeholder="您的称呼" class="input-paper" required />
        <input type="email" placeholder="邮箱（选填）" class="input-paper" />
      </div>
      <textarea placeholder="写下您的留言..." class="input-paper textarea" required></textarea>
      <div class="form-footer">
        <label class="private-checkbox">
          <input type="checkbox" />
          <span>悄悄话（仅主人可见）</span>
        </label>
        <button type="submit" class="btn-paper">提交留言</button>
      </div>
    </form>
  </section>

  <!-- 留言列表 -->
  <section class="messages-section">
    <h3 class="section-title">访客留言 <span class="count">({messages.filter(m => !m.isPrivate).length})</span></h3>
    <div class="messages-list">
      {messages.filter(m => !m.isPrivate).map(msg => (
        <div class="message-item">
          <div class="message-header">
            <span class="message-user">{msg.user}</span>
            <span class="message-date">{msg.date}</span>
          </div>
          <p class="message-content">{msg.content}</p>
        </div>
      ))}
    </div>
  </section>
</BookLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line-color);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .header-left {
    z-index: 1;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.25rem 0;
    font-family: var(--font-serif);
  }

  .page-subtitle {
    color: var(--text-light);
    font-size: 0.875rem;
    font-family: var(--font-serif);
  }

  .header-right {
    position: relative;
    z-index: 1;
  }

  .page-header-bg {
    font-size: 3rem;
    font-weight: 300;
    color: #cfcfcf;
    position: absolute;
    top: -1rem;
    right: 3.5rem;
    opacity: 0.3;
    user-select: none;
    font-family: var(--font-serif);
  }

  .seal-stamp {
    width: 48px;
    height: 48px;
    border: 2px solid var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: bold;
    transform: rotate(12deg);
    opacity: 0.7;
    font-family: var(--font-serif);
  }

  .host-section {
    margin-bottom: 2rem;
  }

  .host-card {
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(139, 58, 58, 0.05) 0%, rgba(139, 58, 58, 0.02) 100%);
    border: 1px solid var(--line-color);
    border-left: 4px solid var(--accent-color);
  }

  .host-label {
    font-size: 0.75rem;
    color: var(--accent-color);
    letter-spacing: 0.2em;
    margin: 0 0 0.75rem 0;
    font-family: var(--font-serif);
  }

  .host-content {
    font-size: 1rem;
    line-height: 1.8;
    margin: 0 0 1rem 0;
    color: var(--text-main);
    font-family: var(--font-serif);
  }

  .host-signature {
    font-size: 0.875rem;
    color: var(--text-light);
    text-align: right;
    margin: 0;
    font-family: var(--font-serif);
  }

  .section-title {
    font-size: 1rem;
    font-weight: 700;
    border-left: 4px solid var(--accent-color);
    padding-left: 0.75rem;
    margin-bottom: 1rem;
    color: var(--text-main);
    letter-spacing: 0.1em;
    font-family: var(--font-serif);
  }

  .form-section {
    margin-bottom: 2rem;
  }

  .message-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .input-paper {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--line-color);
    background-color: rgba(255,255,255,0.5);
    font-family: var(--font-serif);
    font-size: 0.875rem;
  }

  .input-paper:focus {
    outline: none;
    border-color: var(--accent-color);
    background-color: white;
  }

  .textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .private-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-light);
    cursor: pointer;
    font-family: var(--font-serif);
  }

  .private-checkbox input {
    width: 16px;
    height: 16px;
    accent-color: var(--accent-color);
  }

  .btn-paper {
    background-color: var(--accent-color);
    color: white;
    padding: 0.5rem 1.25rem;
    border: none;
    font-family: var(--font-serif);
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-paper:hover {
    background-color: #6b2a2a;
  }

  .messages-section {
    margin-top: 2rem;
  }

  .count {
    font-weight: 400;
    color: var(--text-light);
    font-size: 0.875rem;
  }

  .messages-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .message-item {
    padding: 1rem;
    border: 1px solid var(--line-color);
    background: rgba(255,255,255,0.4);
  }

  .message-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .message-user {
    font-weight: 600;
    color: var(--accent-color);
    font-size: 0.875rem;
    font-family: var(--font-serif);
  }

  .message-date {
    font-size: 0.75rem;
    color: var(--text-light);
    font-family: var(--font-serif);
  }

  .message-content {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    color: var(--text-main);
    font-family: var(--font-serif);
  }
</style>
