---
import BookLayout from '../layouts/BookLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Pagination from '../components/Pagination.astro';

const currentPage = 1;
const totalPages = 1;
const currentPath = '/guestbook';

const messages = [
  {
    id: 1,
    user_name: '清风徐来',
    content: '偶然发现这个博客，文笔真好，像是在读一本泛黄的旧书。希望能一直写下去。',
    created_at: '2024-05-20 14:32',
    is_admin: false,
    is_private: false,
    reply: null
  },
  {
    id: 2,
    user_name: '云中漫步',
    content: '博主的生活态度很让人羡慕，记录生活的习惯也很棒。加油！',
    created_at: '2024-05-19 09:15',
    is_admin: true,
    is_private: false,
    reply: '谢谢云中漫步的鼓励，有空常来坐坐。'
  },
  {
    id: 3,
    user_name: '静水流深',
    content: '悄悄话：博主真是个有趣的人，希望能成为朋友。',
    created_at: '2024-05-18 22:45',
    is_admin: false,
    is_private: true,
    reply: null
  }
];

const hostMessage = '欢迎来到我的留言板。这里是一个安静的角落，你可以留下只属于我们的悄悄话。每一条留言我都会认真阅读，期待与你的相遇。';
const hostSignature = '—— 主人敬上';
---

<BookLayout title="访客留言" subtitle="Guestbook" sealChar="访" sealRotate={6}>
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 主人寄语 -->
  <div class="host-message">
    <div class="host-content">
      {hostMessage}
    </div>
    <div class="host-signature">
      {hostSignature}
    </div>
  </div>

  <!-- 留言输入 -->
  <div class="input-area mb-12">
    <div class="flex gap-4 items-start">
      <div class="avatar">
        <i class="ph ph-user text-xl text-gray-400"></i>
      </div>
      <div class="flex-1">
        <div class="flex gap-4 mb-4">
          <input 
            type="text" 
            placeholder="你的名字" 
            class="vintage-search flex-1 max-w-[200px]"
            id="guest-name"
          />
          <input 
            type="email" 
            placeholder="邮箱（选填）" 
            class="vintage-search flex-1 max-w-[200px]"
            id="guest-email"
          />
        </div>
        <textarea 
          class="letter-paper w-full h-32 mb-4"
          placeholder="写下你想说的话..."
          id="message-content"
        ></textarea>
        <div class="flex justify-between items-center">
          <label class="checkbox-wrapper">
            <input type="checkbox" id="is-private" />
            <span>悄悄话（仅博主可见）</span>
          </label>
          <button class="btn-post" onclick="submitMessage()"></button>
        </div>
      </div>
    </div>
  </div>

  <!-- 留言列表 -->
  <div class="message-list">
    {messages.map((msg, idx) => (
      <div class="message-card" data-floor={messages.length - idx}>
        <div class={`avatar ${msg.is_admin ? 'avatar-admin' : ''}`}>
          {msg.user_name.charAt(0)}
        </div>
        <div class="message-body">
          <div class="message-header">
            <div class="flex items-baseline gap-2">
              <span class="sender-name">{msg.user_name}</span>
              {msg.is_admin && (
                <span class="text-xs text-[#8b3a3a] font-hand bg-[#8b3a3a]/10 px-2 py-0.5 rounded">博主</span>
              )}
            </div>
            <div class="flex items-center gap-2">
              <span class="message-time">{msg.created_at}</span>
              <span class="floor-tag">#{messages.length - idx}楼</span>
            </div>
          </div>
          
          {msg.is_private && !document?.body?.classList?.contains('is-admin') ? (
            <div class="message-secret">
              <i class="ph ph-eye-slash"></i>
              <span>这是一条悄悄话，只有博主能看到哦~</span>
            </div>
          ) : (
            <div class="message-content">{msg.content}</div>
          )}
          
          {msg.reply && (
            <div class="admin-reply">
              <span class="reply-label">博主回复</span>
              <span class="reply-text">{msg.reply}</span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- 分页 -->
  <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/guestbook" />
</BookLayout>

<script is:inline>
  function submitMessage() {
    const name = document.getElementById('guest-name').value;
    const content = document.getElementById('message-content').value;
    const isPrivate = document.getElementById('is-private').checked;
    
    if (!name || !content) {
      alert('请填写姓名和留言内容');
      return;
    }
    
    // TODO: 提交留言
    alert('留言已提交，感谢你的来访！');
    document.getElementById('guest-name').value = '';
    document.getElementById('message-content').value = '';
    document.getElementById('is-private').checked = false;
  }
</script>

<style>
  .vintage-search {
    background: transparent;
    border: none;
    border-bottom: 1px dashed #dcd3b2;
    font-family: var(--font-hand);
    color: #2c2c2c;
    padding: 4px 0;
    font-size: 0.9rem;
    outline: none;
    transition: all 0.3s ease;
  }
  
  .vintage-search:focus {
    border-bottom: 1px solid #8b3a3a;
  }
  
  .vintage-search::placeholder {
    color: #a8a8a8;
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>
