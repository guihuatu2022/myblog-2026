---
import AdminLayout from '../../../layouts/AdminLayout.astro';

// 分类
const categories = [
  { id: '1', name: '全部', count: 42 },
  { id: '2', name: '随笔', count: 18 },
  { id: '3', name: '摄影', count: 12 },
  { id: '4', name: '技术', count: 8 },
  { id: '5', name: '读书', count: 4 },
];

// 状态
const statuses = [
  { id: 'all', name: '全部', count: 42 },
  { id: 'published', name: '已发布', count: 35 },
  { id: 'draft', name: '草稿', count: 7 },
];

// 权限
const permissions = [
  { id: 'all', name: '全部' },
  { id: 'public', name: '公开' },
  { id: 'encrypted', name: '加密' },
  { id: 'private', name: '私有' },
];

// 文章数据
const posts = [
  { id: '1', title: '三十岁的第一个清晨', category: '随笔', date: '2024-05-20', status: 'published', permission: 'public', isPinned: true, views: 128 },
  { id: '2', title: '胶片里的老街', category: '摄影', date: '2024-05-18', status: 'published', permission: 'public', isPinned: false, views: 89 },
  { id: '3', title: '搭建博客的一些心得', category: '技术', date: '2024-05-15', status: 'published', permission: 'public', isPinned: false, views: 156 },
  { id: '4', title: '读《瓦尔登湖》', category: '读书', date: '2024-05-10', status: 'published', permission: 'public', isPinned: false, views: 67 },
  { id: '5', title: '夏日午后的咖啡馆', category: '随笔', date: '2024-05-08', status: 'encrypted', permission: 'encrypted', isPinned: false, views: 23 },
  { id: '6', title: '城市的黄昏', category: '摄影', date: '2024-05-05', status: 'published', permission: 'public', isPinned: false, views: 45 },
  { id: '7', title: '关于 TypeScript 的思考', category: '技术', date: '2024-05-02', status: 'draft', permission: 'public', isPinned: false, views: 0 },
  { id: '8', title: '童年记忆', category: '随笔', date: '2024-04-28', status: 'private', permission: 'private', isPinned: false, views: 5 },
];

// 获取权限图标
function getPermissionIcon(p: string) {
  if (p === 'encrypted') return '🔐';
  if (p === 'private') return '🔒';
  return '🌐';
}
---

<AdminLayout title="日志管理" activeMenu="log">
  <!-- 页面标题 -->
  <div class="page-header">
    <h1 class="page-title">日志管理</h1>
    <a href="/admin/log/new" class="btn btn-primary">
      <i class="ph ph-plus"></i>
      写文章
    </a>
  </div>

  <!-- 分类Tab -->
  <div class="admin-card">
    <div class="flex items-center gap-4 mb-4 pb-4 border-b border-[#e8e8e8]">
      <span class="text-sm text-[#999]">分类</span>
      <div class="flex gap-2 flex-wrap">
        {categories.map((cat, i) => (
          <button 
            class={`tab-btn ${i === 0 ? 'active' : ''}`}
            data-category={cat.name}
          >
            {cat.name}
            <span class="tab-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>
    
    <!-- 状态和权限筛选 -->
    <div class="flex flex-wrap gap-4 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-sm text-[#999]">状态</span>
        <select class="form-input w-32">
          {statuses.map(s => (
            <option value={s.id}>{s.name} ({s.count})</option>
          ))}
        </select>
      </div>
      
      <div class="flex items-center gap-2">
        <span class="text-sm text-[#999]">权限</span>
        <select class="form-input w-28">
          {permissions.map(p => (
            <option value={p.id}>{p.name}</option>
          ))}
        </select>
      </div>
      
      <div class="flex-1"></div>
      
      <div class="relative">
        <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-[#999]"></i>
        <input 
          type="text" 
          placeholder="搜索文章..." 
          class="form-input pl-9 w-64"
        />
      </div>
    </div>
    
    <!-- 批量操作 -->
    <div class="flex items-center gap-4 mb-4 p-3 bg-[#fafafa] rounded-lg">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" id="select-all" class="w-4 h-4 accent-[#8b3a3a]" />
        <span class="text-sm">全选</span>
      </label>
      <span class="text-sm text-[#999]">已选择 <span id="selected-count">0</span> 篇</span>
      <div class="flex gap-2">
        <button class="btn btn-default btn-sm" id="batch-move">
          <i class="ph ph-folder-simple mr-1"></i>
          移动分类
        </button>
        <button class="btn btn-default btn-sm" id="batch-pin">
          <i class="ph ph-push-pin mr-1"></i>
          置顶/取消
        </button>
        <button class="btn btn-danger btn-sm" id="batch-delete">
          <i class="ph ph-trash mr-1"></i>
          删除
        </button>
      </div>
    </div>
    
    <!-- 文章列表 -->
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 40px;"></th>
          <th style="width: 50px;">置顶</th>
          <th>标题</th>
          <th style="width: 80px;">分类</th>
          <th style="width: 100px;">日期</th>
          <th style="width: 80px;">权限</th>
          <th style="width: 80px;">状态</th>
          <th style="width: 60px;">阅读</th>
          <th style="width: 120px;">操作</th>
        </tr>
      </thead>
      <tbody>
        {posts.map((post) => (
          <tr data-id={post.id}>
            <td>
              <input type="checkbox" class="post-checkbox w-4 h-4 accent-[#8b3a3a]" />
            </td>
            <td>
              <button 
                class={`pin-btn ${post.isPinned ? 'text-[#8b3a3a]' : 'text-[#ccc]'}`}
                data-id={post.id}
                title={post.isPinned ? '取消置顶' : '置顶'}
              >
                <i class={`ph ${post.isPinned ? 'ph-push-pin-fill' : 'ph-push-pin'}`}></i>
              </button>
            </td>
            <td>
              <div class="flex items-center gap-2">
                <a href={`/admin/log/${post.id}`} class="font-medium hover:text-[#8b3a3a]">
                  {post.title}
                </a>
                {post.isPinned && (
                  <span class="text-xs text-[#8b3a3a]">
                    <i class="ph ph-push-pin"></i>
                  </span>
                )}
              </div>
            </td>
            <td><span class="tag tag-red">{post.category}</span></td>
            <td class="text-[#999]">{post.date}</td>
            <td>
              <span title={post.permission}>
                {getPermissionIcon(post.permission)}
              </span>
            </td>
            <td>
              <span class={`tag ${post.status === 'published' ? 'tag-green' : 'tag-gray'}`}>
                {post.status === 'published' ? '已发布' : '草稿'}
              </span>
            </td>
            <td class="text-[#999]">{post.views}</td>
            <td>
              <div class="flex gap-3">
                <a href={`/admin/log/${post.id}`} class="text-[#999] hover:text-[#8b3a3a]" title="编辑">
                  <i class="ph ph-pencil-simple"></i>
                </a>
                <a href={`/admin/log/${post.id}/attachments`} class="text-[#999] hover:text-[#8b3a3a]" title="附件">
                  <i class="ph ph-paperclip"></i>
                </a>
                <a href={`/log/${post.id}`} target="_blank" class="text-[#999] hover:text-[#8b3a3a]" title="预览">
                  <i class="ph ph-eye"></i>
                </a>
                <button class="text-[#999] hover:text-red-500 delete-btn" data-id={post.id} title="删除">
                  <i class="ph ph-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    
    <!-- 分页 -->
    <div class="pagination">
      <button class="pagination-item disabled">
        <i class="ph ph-caret-left"></i>
      </button>
      <button class="pagination-item active">1</button>
      <button class="pagination-item">2</button>
      <button class="pagination-item">3</button>
      <button class="pagination-item">
        <i class="ph ph-caret-right"></i>
      </button>
    </div>
  </div>
</AdminLayout>

<style>
  .tab-btn {
    padding: 6px 14px;
    border: 1px solid #e8e8e8;
    border-radius: 20px;
    background: #fff;
    font-size: 13px;
    color: #666;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .tab-btn:hover {
    border-color: #8b3a3a;
    color: #8b3a3a;
  }
  
  .tab-btn.active {
    background: #8b3a3a;
    border-color: #8b3a3a;
    color: #fff;
  }
  
  .tab-count {
    margin-left: 4px;
    opacity: 0.7;
  }
  
  .pin-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    transition: color 0.3s;
  }
  
  .pin-btn:hover {
    color: #8b3a3a !important;
  }
</style>

<script>
  // 全选
  const selectAll = document.getElementById('select-all');
  const checkboxes = document.querySelectorAll('.post-checkbox');
  const selectedCount = document.getElementById('selected-count');
  
  selectAll?.addEventListener('change', (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    checkboxes.forEach(cb => (cb as HTMLInputElement).checked = checked);
    updateSelectedCount();
  });
  
  checkboxes.forEach(cb => cb.addEventListener('change', updateSelectedCount));
  
  function updateSelectedCount() {
    const checked = document.querySelectorAll('.post-checkbox:checked').length;
    if (selectedCount) selectedCount.textContent = checked.toString();
  }
  
  // 置顶按钮
  document.querySelectorAll('.pin-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      console.log('切换置顶:', (btn as HTMLElement).dataset.id);
      // TODO: 调用 API
    });
  });
  
  // 删除按钮
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.id;
      if (confirm('确定要删除这篇文章吗？')) {
        console.log('删除文章:', id);
        // TODO: 调用 API
      }
    });
  });
</script>
