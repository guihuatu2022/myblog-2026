---
import AdminLayout from '../../layouts/AdminLayout.astro';

// 模拟统计数据
const stats = {
  posts: 42,
  albums: 8,
  files: 127,
  messages: 36,
  todos: 7,
  todosDone: 4,
};

// 最近文章
const recentPosts = [
  { id: '1', title: '三十岁的第一个清晨', date: '2024-05-20', views: 128, category: '随笔' },
  { id: '2', title: '胶片里的老街', date: '2024-05-18', views: 89, category: '摄影' },
  { id: '3', title: '搭建博客的一些心得', date: '2024-05-15', views: 156, category: '技术' },
  { id: '4', title: '读《瓦尔登湖》', date: '2024-05-10', views: 67, category: '读书' },
];

// 最近留言
const recentMessages = [
  { id: '1', userName: '海边旅人', content: '偶然路过，写得真好...', date: '2024-05-21 14:32' },
  { id: '2', userName: '云中漫步', content: '三十岁的文章看完了，深有同感。', date: '2024-05-22 09:15' },
];

// 快捷操作
const quickActions = [
  { label: '写文章', icon: 'ph-pencil-simple', href: '/admin/log/new', color: 'primary' },
  { label: '上传照片', icon: 'ph-image', href: '/admin/album', color: 'success' },
  { label: '上传文件', icon: 'ph-upload', href: '/admin/drive', color: 'warning' },
  { label: '查看留言', icon: 'ph-chat-circle-dots', href: '/admin/message', color: 'info' },
];
---

<AdminLayout title="仪表盘" activeMenu="dashboard">
  <!-- 页面标题 -->
  <div class="page-header">
    <h1 class="page-title">仪表盘</h1>
    <a href="/admin/log/new" class="btn btn-primary">
      <i class="ph ph-plus"></i>
      写文章
    </a>
  </div>

  <!-- 统计卡片 -->
  <div class="stat-cards">
    <div class="stat-card-admin">
      <div class="stat-icon primary">
        <i class="ph ph-article"></i>
      </div>
      <div class="stat-info">
        <h3>{stats.posts}</h3>
        <p>文章总数</p>
      </div>
    </div>
    
    <div class="stat-card-admin">
      <div class="stat-icon success">
        <i class="ph ph-images"></i>
      </div>
      <div class="stat-info">
        <h3>{stats.albums}</h3>
        <p>相册数量</p>
      </div>
    </div>
    
    <div class="stat-card-admin">
      <div class="stat-icon warning">
        <i class="ph ph-folder-simple"></i>
      </div>
      <div class="stat-info">
        <h3>{stats.files}</h3>
        <p>文件数量</p>
      </div>
    </div>
    
    <div class="stat-card-admin">
      <div class="stat-icon info">
        <i class="ph ph-chat-circle-dots"></i>
      </div>
      <div class="stat-info">
        <h3>{stats.messages}</h3>
        <p>留言总数</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- 快捷操作 -->
    <div class="admin-card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="ph ph-lightning mr-2"></i>
          快捷操作
        </h3>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {quickActions.map((action) => (
          <a href={action.href} class="quick-action">
            <div class={`quick-action-icon ${action.color}`}>
              <i class={`ph ${action.icon}`}></i>
            </div>
            <span>{action.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- 待办进度 -->
    <div class="admin-card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="ph ph-check-square mr-2"></i>
          待办事项
        </h3>
        <a href="/admin/todo" class="text-sm text-[#8b3a3a]">查看全部</a>
      </div>
      <div class="mb-4">
        <div class="flex justify-between text-sm mb-2">
          <span>完成进度</span>
          <span class="text-[#8b3a3a]">{stats.todosDone}/{stats.todos}</span>
        </div>
        <div class="h-2 bg-[#f0f2f5] rounded-full overflow-hidden">
          <div 
            class="h-full bg-[#8b3a3a] transition-all"
            style={`width: ${(stats.todosDone / stats.todos) * 100}%`}
          ></div>
        </div>
      </div>
      <a href="/admin/todo/new" class="btn btn-default btn-sm w-full">
        <i class="ph ph-plus mr-1"></i>
        添加待办
      </a>
    </div>

    <!-- 系统信息 -->
    <div class="admin-card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="ph ph-info mr-2"></i>
          系统信息
        </h3>
      </div>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-[#999]">系统版本</span>
          <span>1.0.0</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#999]">数据库</span>
          <span>Cloudflare D1</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#999]">存储服务</span>
          <span>OpenList</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#999]">部署平台</span>
          <span>Cloudflare Pages</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 最近文章 -->
  <div class="admin-card">
    <div class="card-header">
      <h3 class="card-title">
        <i class="ph ph-clock-counter-clockwise mr-2"></i>
        最近文章
      </h3>
      <a href="/admin/log" class="text-sm text-[#8b3a3a]">查看全部</a>
    </div>
    <table class="admin-table">
      <thead>
        <tr>
          <th>标题</th>
          <th>分类</th>
          <th>日期</th>
          <th>阅读</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {recentPosts.map((post) => (
          <tr>
            <td>
              <a href={`/admin/log/${post.id}`} class="text-[#8b3a3a] hover:underline">
                {post.title}
              </a>
            </td>
            <td><span class="tag tag-red">{post.category}</span></td>
            <td class="text-[#999]">{post.date}</td>
            <td class="text-[#999]">{post.views}</td>
            <td>
              <div class="flex gap-2">
                <a href={`/admin/log/${post.id}`} class="text-[#999] hover:text-[#8b3a3a]">
                  <i class="ph ph-pencil-simple"></i>
                </a>
                <a href={`/log/${post.id}`} target="_blank" class="text-[#999] hover:text-[#8b3a3a]">
                  <i class="ph ph-eye"></i>
                </a>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- 最近留言 -->
  <div class="admin-card">
    <div class="card-header">
      <h3 class="card-title">
        <i class="ph ph-chat-circle-dots mr-2"></i>
        最近留言
      </h3>
      <a href="/admin/message" class="text-sm text-[#8b3a3a]">查看全部</a>
    </div>
    <div class="space-y-4">
      {recentMessages.map((msg) => (
        <div class="flex gap-4 pb-4 border-b border-[#e8e8e8] last:border-0 last:pb-0">
          <div class="w-10 h-10 rounded-full bg-[#f0f2f5] flex items-center justify-center text-[#8b3a3a]">
            <i class="ph ph-user"></i>
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-center mb-1">
              <span class="font-medium">{msg.userName}</span>
              <span class="text-xs text-[#999]">{msg.date}</span>
            </div>
            <p class="text-sm text-[#666]">{msg.content}</p>
          </div>
          <div class="flex gap-2">
            <button class="text-[#999] hover:text-[#8b3a3a]">
              <i class="ph ph-arrow-bend-up-left"></i>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>

<style>
  .quick-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px;
    background: #fafafa;
    border-radius: 8px;
    text-decoration: none;
    color: var(--admin-text);
    transition: all 0.3s;
  }
  
  .quick-action:hover {
    background: #f0f2f5;
    transform: translateY(-2px);
  }
  
  .quick-action-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  
  .quick-action-icon.primary { background: #fff2f0; color: var(--primary); }
  .quick-action-icon.success { background: #f6ffed; color: var(--success); }
  .quick-action-icon.warning { background: #fffbe6; color: var(--warning); }
  .quick-action-icon.info { background: #e6f7ff; color: var(--info); }
  
  .quick-action span {
    font-size: 13px;
  }
</style>
