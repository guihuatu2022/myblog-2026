---
import BookLayout from '../layouts/BookLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const currentPath = '/nav';

const categories = [
  {
    name: '技术',
    icon: 'ph-code',
    sites: [
      { name: 'GitHub', url: 'https://github.com', desc: '代码仓库' },
      { name: 'Stack Overflow', url: 'https://stackoverflow.com', desc: '技术问答' },
      { name: 'MDN', url: 'https://developer.mozilla.org', desc: '前端文档' },
    ]
  },
  {
    name: '设计',
    icon: 'ph-palette',
    sites: [
      { name: 'Dribbble', url: 'https://dribbble.com', desc: '设计作品' },
      { name: 'Behance', url: 'https://behance.net', desc: '创意设计' },
    ]
  },
  {
    name: '生活',
    icon: 'ph-coffee',
    sites: [
      { name: '豆瓣', url: 'https://douban.com', desc: '读书电影' },
      { name: '即刻', url: 'https://jike.city', desc: '兴趣社区' },
    ]
  }
];
---

<BookLayout title="常用导航" subtitle="Bookmarks" sealChar="链" sealRotate={8}>
  <Fragment slot="sidebar">
    <Sidebar currentPath={currentPath} />
  </Fragment>

  <!-- 分类导航 -->
  <div class="nav-categories flex-1">
    {categories.map((cat) => (
      <div class="nav-category mb-12">
        <div class="category-header flex items-center gap-3 mb-6">
          <i class={`ph ${cat.icon} text-xl text-[#8b3a3a]`}></i>
          <h2 class="category-title text-xl font-bold text-[#2c2c2c] font-serif">{cat.name}</h2>
          <div class="flex-1 h-px bg-gradient-to-r from-[#dcd3b2] to-transparent"></div>
        </div>
        
        <div class="site-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {cat.sites.map(site => (
            <a 
              href={site.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-card"
            >
              <div class="site-icon">
                <i class="ph ph-globe text-2xl text-[#8b3a3a]"></i>
              </div>
              <div class="site-info">
                <h3 class="site-name">{site.name}</h3>
                <p class="site-desc">{site.desc}</p>
              </div>
              <div class="site-arrow">
                <i class="ph ph-arrow-up-right text-gray-400"></i>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</BookLayout>

<style>
  .site-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: var(--paper-white);
    border: 1px solid #dcd3b2;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-decoration: none;
  }
  
  .site-card:hover {
    border-color: #8b3a3a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 58, 58, 0.1);
  }
  
  .site-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(139, 58, 58, 0.1);
    border-radius: 50%;
    flex-shrink: 0;
  }
  
  .site-info {
    flex: 1;
    min-width: 0;
  }
  
  .site-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: #2c2c2c;
    margin-bottom: 2px;
  }
  
  .site-desc {
    font-size: 0.8rem;
    color: #888;
  }
  
  .site-arrow {
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .site-card:hover .site-arrow {
    opacity: 1;
  }
</style>
