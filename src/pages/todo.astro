---
import BookLayout from '../layouts/BookLayout.astro';

// 模拟数据
const todos = [
  { id: '1', content: '完成博客系统开发', status: 'done', dueDate: '2024-05-31' },
  { id: '2', content: '学习 Astro 框架进阶用法', status: 'done', dueDate: '2024-05-25' },
  { id: '3', content: '搭建 OpenList 文件存储服务', status: 'in_progress', dueDate: '2024-06-15' },
  { id: '4', content: '配置 Cloudflare D1 数据库', status: 'pending', dueDate: '2024-06-10' },
  { id: '5', content: '部署博客到 Cloudflare Pages', status: 'pending', dueDate: '2024-06-20' },
  { id: '6', content: '申请 DeepSeek API 用于 AI 辅助', status: 'pending', dueDate: '2024-06-25' },
  { id: '7', content: '整理博客文章配图', status: 'pending', dueDate: '2024-07-01' },
];

const stats = {
  total: todos.length,
  done: todos.filter(t => t.status === 'done').length,
  inProgress: todos.filter(t => t.status === 'in_progress').length,
  pending: todos.filter(t => t.status === 'pending').length,
};

const progress = Math.round((stats.done / stats.total) * 100);

const statusLabels: Record<string, { label: string; class: string }> = {
  done: { label: '已完成', class: 'tag-green' },
  in_progress: { label: '进行中', class: 'tag-yellow' },
  pending: { label: '待开始', class: 'tag-gray' },
};

const statusFilters = ['全部', '待开始', '进行中', '已完成'];
---

<BookLayout title="我的待办">
  <div class="flex justify-between items-end mb-6 pb-4 border-b border-[#dcd3b2]">
    <div>
      <h2 class="text-3xl font-bold font-serif text-[#2c2c2c]">我的待办</h2>
      <p class="text-sm font-hand text-[#8b3a3a]">计划表 · 目标清单</p>
    </div>
    <div class="text-sm font-hand text-[#8b7355]">
      <i class="ph ph-calendar-blank mr-1"></i>
      {new Date().toLocaleDateString('zh-CN')}
    </div>
  </div>

  <!-- 统计卡片 -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="stat-card text-center">
      <p class="text-3xl font-bold font-calligraphy text-[#8b3a3a]">{stats.total}</p>
      <p class="text-sm font-hand text-[#8b7355]">全部</p>
    </div>
    <div class="stat-card text-center">
      <p class="text-3xl font-bold font-calligraphy text-[#4a9c6d]">{stats.done}</p>
      <p class="text-sm font-hand text-[#8b7355]">已完成</p>
    </div>
    <div class="stat-card text-center">
      <p class="text-3xl font-bold font-calligraphy text-[#d4a82c]">{stats.inProgress}</p>
      <p class="text-sm font-hand text-[#8b7355]">进行中</p>
    </div>
    <div class="stat-card text-center">
      <p class="text-3xl font-bold font-calligraphy text-[#8b7355]">{stats.pending}</p>
      <p class="text-sm font-hand text-[#8b7355]">待开始</p>
    </div>
  </div>

  <!-- 进度条 -->
  <div class="stat-card mb-6">
    <div class="flex justify-between items-center mb-2">
      <span class="font-serif font-bold text-[#2c2c2c]">完成进度</span>
      <span class="font-hand text-[#8b3a3a]">{progress}%</span>
    </div>
    <div class="h-3 bg-[#dcd3b2] rounded-full overflow-hidden">
      <div 
        class="h-full bg-gradient-to-r from-[#8b3a3a] to-[#d4a82c] transition-all duration-500"
        style={`width: ${progress}%`}
      ></div>
    </div>
  </div>

  <!-- 筛选 -->
  <div class="flex gap-2 mb-6">
    {statusFilters.map((filter, i) => (
      <span 
        class={`index-link ${i === 0 ? 'active' : ''}`}
        onclick={`filterTodos('${filter}')`}
      >
        {filter}
      </span>
    ))}
  </div>

  <!-- 待办列表 -->
  <div class="space-y-3" id="todo-list">
    {todos.map((todo) => (
      <div 
        class={`stat-card flex items-center gap-4 todo-item ${todo.status === 'done' ? 'opacity-60' : ''}`}
        data-status={todo.status}
      >
        <button 
          class={`w-6 h-6 rounded-full border-2 flex items-center justify-center transition-colors ${
            todo.status === 'done' 
              ? 'bg-[#4a9c6d] border-[#4a9c6d] text-white' 
              : todo.status === 'in_progress'
              ? 'border-[#d4a82c] text-[#d4a82c]'
              : 'border-[#dcd3b2] hover:border-[#8b3a3a]'
          }`}
          onclick={`toggleTodo('${todo.id}')`}
        >
          {todo.status === 'done' && <i class="ph ph-check text-sm"></i>}
          {todo.status === 'in_progress' && <i class="ph ph-circle-dashed text-sm"></i>}
        </button>
        
        <div class="flex-1">
          <p class={`font-serif ${todo.status === 'done' ? 'line-through text-[#8b7355]' : 'text-[#2c2c2c]'}`}>
            {todo.content}
          </p>
          <p class="text-xs text-[#8b7355] font-hand mt-1">
            <i class="ph ph-calendar mr-1"></i>
            {todo.dueDate}
          </p>
        </div>
        
        <span class={`tag text-xs ${statusLabels[todo.status].class}`}>
          {statusLabels[todo.status].label}
        </span>
        
        <div class="flex gap-2">
          <button class="text-[#8b7355] hover:text-[#8b3a3a] transition-colors">
            <i class="ph ph-pencil-simple"></i>
          </button>
          <button class="text-[#8b7355] hover:text-red-500 transition-colors">
            <i class="ph ph-trash"></i>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- 添加新待办 -->
  <div class="stat-card mt-6">
    <form id="todo-form" class="flex gap-3">
      <input 
        type="text" 
        class="form-input flex-1" 
        placeholder="添加新的待办事项..."
        required
      />
      <input 
        type="date" 
        class="form-input w-40"
      />
      <button type="submit" class="btn btn-primary">
        <i class="ph ph-plus mr-1"></i>
        添加
      </button>
    </form>
  </div>

  <!-- 底部 -->
  <footer class="mt-10 pt-6 border-t border-[#dcd3b2] text-center">
    <p class="text-sm font-hand text-[#8b7355]">
      朝花夕拾 · 岁月静好
    </p>
  </footer>
</BookLayout>

<style>
  .line-through {
    text-decoration: line-through;
  }
  
  .todo-item {
    transition: opacity 0.3s;
  }
</style>

<script>
  // 切换待办状态
  function toggleTodo(id: string) {
    console.log('切换待办:', id);
    // TODO: 调用 API 更新状态
  }

  // 筛选待办
  function filterTodos(filter: string) {
    const items = document.querySelectorAll('.todo-item');
    items.forEach(item => {
      const status = (item as HTMLElement).dataset.status;
      if (filter === '全部' || status === filter) {
        (item as HTMLElement).style.display = '';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  }

  // 添加待办
  const form = document.getElementById('todo-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const content = formData.get('content');
    const dueDate = formData.get('dueDate');
    console.log('添加待办:', { content, dueDate });
    // TODO: 调用 API
    alert('待办已添加！');
    form.reset();
  });
</script>
