---
interface Props {
  tabs: Array<{
    id: string;
    label: string;
    count?: number;
  }>;
  activeTab: string;
  baseUrl: string;
}

const { tabs, activeTab, baseUrl } = Astro.props;
---

<div class="flex items-center gap-1 p-1 bg-gray-100 rounded-lg w-fit">
  {tabs.map((tab) => (
    <a 
      href={tab.id === 'all' ? baseUrl : `${baseUrl}?filter=${tab.id}`}
      class={`px-4 py-2 text-sm rounded-md transition-colors ${
        activeTab === tab.id 
          ? 'bg-white text-[#8b3a3a] shadow-sm font-medium' 
          : 'text-gray-600 hover:text-gray-900'
      }`}
    >
      {tab.label}
      {tab.count !== undefined && (
        <span class={`ml-2 px-2 py-0.5 text-xs rounded-full ${
          activeTab === tab.id 
            ? 'bg-[#8b3a3a]/10 text-[#8b3a3a]' 
            : 'bg-gray-200 text-gray-500'
        }`}>
          {tab.count}
        </span>
      )}
    </a>
  ))}
</div>
