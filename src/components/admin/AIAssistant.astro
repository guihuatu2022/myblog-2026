---
interface Props {
  contentId: string; // 关联的编辑器 ID
}

const { contentId } = Astro.props;

const aiActions = [
  { id: 'check-typos', label: '检查错别字', icon: 'ph-spell-check', description: '检查文本中的错别字和错误' },
  { id: 'generate-title', label: '生成标题', icon: 'ph-text-aa', description: '根据内容生成标题建议' },
  { id: 'generate-excerpt', label: '生成摘要', icon: 'ph-text-align-left', description: '生成文章摘要' },
  { id: 'continue', label: '续写内容', icon: 'ph-pencil-line', description: '续写当前内容' },
  { id: 'polish', label: '美化内容', icon: 'ph-magic-wand', description: '润色优化文章表达' },
  { id: 'expand', label: '扩写内容', icon: 'ph-arrows-out-simple', description: '扩展丰富文章内容' },
  { id: 'suggest-tags', label: '推荐标签', icon: 'ph-tag', description: '根据内容推荐标签' },
];
---

<div class="border border-[#dcd3b2] rounded-lg bg-gray-50 overflow-hidden">
  <!-- 头部 -->
  <div class="px-4 py-3 bg-white border-b border-[#dcd3b2] flex items-center gap-2">
    <div class="w-8 h-8 bg-gradient-to-br from-[#8b3a3a] to-[#a94444] rounded-lg flex items-center justify-center">
      <i class="ph ph-robot text-white text-lg"></i>
    </div>
    <div>
      <h4 class="font-bold text-[#2c2c2c]">AI 写作助手</h4>
      <p class="text-xs text-gray-500">智能辅助，让写作更轻松</p>
    </div>
    <div class="ml-auto">
      <span class="px-2 py-1 text-xs bg-green-100 text-green-700 rounded-full">DeepSeek</span>
    </div>
  </div>
  
  <!-- 功能按钮 -->
  <div class="p-4 grid grid-cols-2 md:grid-cols-4 gap-2">
    {aiActions.map((action) => (
      <button
        type="button"
        class="ai-action-btn flex items-center gap-2 px-3 py-2 bg-white border border-[#dcd3b2] rounded-lg hover:border-[#8b3a3a] hover:bg-[#8b3a3a]/5 transition-colors text-left"
        data-action={action.id}
        title={action.description}
      >
        <i class={`${action.icon} text-[#8b3a3a]`}></i>
        <span class="text-sm text-[#2c2c2c]">{action.label}</span>
      </button>
    ))}
  </div>
  
  <!-- 结果展示区 -->
  <div id="ai-result" class="hidden border-t border-[#dcd3b2]">
    <div class="p-4">
      <div class="flex items-center justify-between mb-3">
        <h5 class="font-medium text-[#2c2c2c]">AI 结果</h5>
        <button type="button" id="ai-close-result" class="text-gray-400 hover:text-gray-600">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>
      <div id="ai-result-content" class="p-4 bg-white rounded-lg border border-[#dcd3b2] min-h-[100px] text-sm text-[#2c2c2c] whitespace-pre-wrap">
        <!-- AI 结果将显示在这里 -->
      </div>
      <div class="flex items-center gap-2 mt-3">
        <button type="button" id="ai-apply" class="px-4 py-2 bg-[#8b3a3a] text-white rounded hover:bg-[#a94444] transition-colors text-sm">
          <i class="ph ph-check mr-1"></i>应用结果
        </button>
        <button type="button" id="ai-copy" class="px-4 py-2 border border-[#dcd3b2] text-gray-600 rounded hover:bg-gray-100 transition-colors text-sm">
          <i class="ph ph-copy mr-1"></i>复制
        </button>
      </div>
    </div>
  </div>
  
  <!-- 加载状态 -->
  <div id="ai-loading" class="hidden border-t border-[#dcd3b2] p-4">
    <div class="flex items-center gap-3">
      <div class="loading-spinner"></div>
      <span class="text-sm text-gray-500">AI 思考中...</span>
    </div>
  </div>
</div>

<script define:vars={{ contentId, aiActions }}>
  const editor = document.getElementById(`${contentId}-editor`);
  const textarea = document.getElementById(`${contentId}-textarea`);
  const resultContainer = document.getElementById('ai-result');
  const resultContent = document.getElementById('ai-result-content');
  const loading = document.getElementById('ai-loading');
  const applyBtn = document.getElementById('ai-apply');
  const copyBtn = document.getElementById('ai-copy');
  const closeBtn = document.getElementById('ai-close-result');
  
  let currentResult = '';
  
  function getContent() {
    return textarea?.value || editor?.innerHTML || '';
  }
  
  function showLoading() {
    if (loading) loading.classList.remove('hidden');
    if (resultContainer) resultContainer.classList.add('hidden');
  }
  
  function hideLoading() {
    if (loading) loading.classList.add('hidden');
  }
  
  function showResult(result) {
    currentResult = result;
    if (resultContent) resultContent.textContent = result;
    if (resultContainer) resultContainer.classList.remove('hidden');
    hideLoading();
  }
  
  async function callAI(action, content) {
    showLoading();
    
    try {
      const response = await fetch(`/api/ai/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content })
      });
      
      const data = await response.json();
      
      if (data.error) {
        throw new Error(data.error);
      }
      
      showResult(data.result);
    } catch (error) {
      hideLoading();
      alert('AI 请求失败: ' + error.message);
    }
  }
  
  // 绑定 AI 按钮事件
  document.querySelectorAll('.ai-action-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const action = btn.dataset.action;
      const content = getContent();
      
      if (!content.trim()) {
        alert('请先输入内容');
        return;
      }
      
      await callAI(action, content);
    });
  });
  
  // 应用结果
  applyBtn?.addEventListener('click', () => {
    const selection = window.getSelection();
    
    if (selection && selection.rangeCount > 0) {
      // 如果有选中文本，替换选中文本
      const range = selection.getRangeAt(0);
      range.deleteContents();
      range.insertNode(document.createTextNode(currentResult));
    } else {
      // 否则在末尾追加
      if (editor) {
        editor.innerHTML += '<p>' + currentResult + '</p>';
      }
      if (textarea) {
        textarea.value += '\n\n' + currentResult;
      }
    }
    
    // 关闭结果
    if (resultContainer) resultContainer.classList.add('hidden');
  });
  
  // 复制结果
  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(currentResult).then(() => {
      alert('已复制到剪贴板');
    });
  });
  
  // 关闭结果
  closeBtn?.addEventListener('click', () => {
    if (resultContainer) resultContainer.classList.add('hidden');
  });
</script>
