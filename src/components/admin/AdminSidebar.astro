---
interface Props {
  currentPage?: string;
}

const { currentPage = 'dashboard' } = Astro.props;

const menuItems = [
  { id: 'dashboard', label: '仪表盘', icon: 'ph-chart-pie', href: '/admin' },
  { id: 'posts', label: '日志管理', icon: 'ph-article', href: '/admin/log' },
  { id: 'albums', label: '相册管理', icon: 'ph-images', href: '/admin/album' },
  { id: 'drive', label: '网盘管理', icon: 'ph-folder-simple', href: '/admin/drive' },
  { id: 'messages', label: '留言管理', icon: 'ph-chats-circle', href: '/admin/message' },
  { id: 'todos', label: '待办清单', icon: 'ph-check-square', href: '/admin/todo' },
  { id: 'links', label: '导航管理', icon: 'ph-link', href: '/admin/nav' },
  { id: 'settings', label: '系统设置', icon: 'ph-gear', href: '/admin/settings' },
];
---

<aside class="admin-sidebar flex flex-col h-screen sticky top-0">
  <!-- Logo -->
  <div class="px-6 py-5 border-b border-gray-700/30">
    <a href="/admin" class="flex items-center gap-3 text-[#e8e8e8] no-underline">
      <div class="w-10 h-10 bg-[#8b3a3a] rounded-lg flex items-center justify-center">
        <span class="font-calligraphy text-xl">书</span>
      </div>
      <div>
        <h1 class="text-lg font-bold font-calligraphy tracking-wider">博客后台</h1>
        <p class="text-[10px] text-gray-500 tracking-widest">ADMIN PANEL</p>
      </div>
    </a>
  </div>
  
  <!-- 菜单 -->
  <nav class="flex-1 py-4 overflow-y-auto">
    <ul class="space-y-1 px-3">
      {menuItems.map((item) => (
        <li>
          <a 
            href={item.href}
            class={`admin-sidebar-item ${currentPage === item.id ? 'active' : ''}`}
          >
            <i class={`${item.icon} text-xl`}></i>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  
  <!-- 底部 -->
  <div class="p-4 border-t border-gray-700/30">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-[#8b3a3a] rounded-full flex items-center justify-center text-white text-sm font-bold">
        管
      </div>
      <div class="flex-1">
        <p class="text-sm text-[#d0d0d0]">管理员</p>
        <a href="/admin/logout" class="text-xs text-gray-500 hover:text-gray-300">退出登录</a>
      </div>
    </div>
    <a 
      href="/" 
      target="_blank"
      class="mt-3 flex items-center justify-center gap-2 px-4 py-2 bg-white/5 hover:bg-white/10 rounded text-sm text-gray-400 hover:text-[#dcd3b2] transition-colors"
    >
      <i class="ph ph-arrow-square-out"></i>
      <span>查看站点</span>
    </a>
  </div>
</aside>

<style>
  .admin-sidebar-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: #a89f91;
    text-decoration: none;
    transition: all 0.2s ease;
    border-radius: 8px;
    margin-bottom: 4px;
  }
  
  .admin-sidebar-item:hover {
    background-color: rgba(255,255,255,0.05);
    color: #dcd3b2;
  }
  
  .admin-sidebar-item.active {
    background-color: rgba(139, 58, 58, 0.2);
    color: #e0d8c8;
  }
</style>
