---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

// 生成分页数字（壹贰叁肆伍陆柒捌玖拾）
const chineseNumbers = ['零', '壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖', '拾'];

// 获取页码数组
function getPageNumbers(current: number, total: number): (number | string)[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }
  
  if (current <= 4) {
    return [1, 2, 3, 4, 5, '...', total];
  }
  
  if (current >= total - 3) {
    return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
  }
  
  return [1, '...', current - 1, current, current + 1, '...', total];
}

const pageNumbers = getPageNumbers(currentPage, totalPages);

function toChinese(num: number): string {
  if (num <= 10) return chineseNumbers[num];
  if (num < 20) return '十' + chineseNumbers[num - 10];
  if (num < 100) return chineseNumbers[Math.floor(num / 10)] + '十' + (num % 10 ? chineseNumbers[num % 10] : '');
  return num.toString();
}
---

{totalPages > 1 && (
  <div class="mt-8 pt-6 border-t border-[#dcd3b2] flex items-center justify-center shrink-0">
    <div class="flex items-center gap-4 font-serif text-sm text-[#5d5d5d]">
      {/* 上一页 */}
      {currentPage > 1 ? (
        <a href={`${baseUrl}?page=${currentPage - 1}`} class="hover:text-[#8b3a3a] transition-colors">
          上一页
        </a>
      ) : (
        <span class="opacity-50 cursor-not-allowed">上一页</span>
      )}

      <span class="text-[#dcd3b2] mx-2">|</span>

      {/* 页码 */}
      {pageNumbers.map(page => (
        typeof page === 'number' ? (
          <a 
            href={`${baseUrl}?page=${page}`}
            class={`pagination-link ${page === currentPage ? 'active' : ''}`}
          >
            {page === currentPage ? `【 ${toChinese(page)} 】` : toChinese(page)}
          </a>
        ) : (
          <span class="text-[#dcd3b2]">...</span>
        )
      ))}

      <span class="text-[#dcd3b2] mx-2">|</span>

      {/* 下一页 */}
      {currentPage < totalPages ? (
        <a href={`${baseUrl}?page=${currentPage + 1}`} class="hover:text-[#8b3a3a] transition-colors">
          下一页
        </a>
      ) : (
        <span class="opacity-50 cursor-not-allowed">下一页</span>
      )}
    </div>
  </div>
)}
