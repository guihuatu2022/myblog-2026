---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  groupSize?: number;
}

const { currentPage, totalPages, baseUrl, groupSize = 5 } = Astro.props;

// 生成分页数据
function generatePagination() {
  const pages: (number | 'ellipsis')[] = [];
  
  if (totalPages <= 1) {
    return pages;
  }
  
  // 简化的分页逻辑
  if (totalPages <= 7) {
    // 全部显示
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    // 复杂分页
    if (currentPage <= 4) {
      // 开头
      for (let i = 1; i <= 5; i++) {
        pages.push(i);
      }
      pages.push('ellipsis');
      pages.push(totalPages);
    } else if (currentPage >= totalPages - 3) {
      // 结尾
      pages.push(1);
      pages.push('ellipsis');
      for (let i = totalPages - 4; i <= totalPages; i++) {
        pages.push(i);
      }
    } else {
      // 中间
      pages.push(1);
      pages.push('ellipsis');
      for (let i = currentPage - 1; i <= currentPage + 1; i++) {
        pages.push(i);
      }
      pages.push('ellipsis');
      pages.push(totalPages);
    }
  }
  
  return pages;
}

// 获取中文数字
function getChineseNum(n: number): string {
  const nums = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
  if (n <= 10) return nums[n];
  if (n < 20) return `十${nums[n - 10]}`;
  if (n < 100) {
    const tens = Math.floor(n / 10);
    const ones = n % 10;
    return `${nums[tens]}十${ones === 0 ? '' : nums[ones]}`;
  }
  return String(n);
}

const pages = generatePagination();
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;

// 生成分页URL
function getPageUrl(page: number): string {
  const url = new URL(baseUrl, 'http://localhost');
  if (page > 1) {
    url.searchParams.set('page', String(page));
  }
  return url.pathname + url.searchParams.toString();
}
---

{totalPages > 1 && (
  <div class="pagination">
    {/* 上一页 */}
    {hasPrev ? (
      <a href={getPageUrl(currentPage - 1)} class="pagination-link">
        <i class="ph ph-caret-left mr-1"></i>
        上一页
      </a>
    ) : (
      <span class="pagination-link disabled">
        <i class="ph ph-caret-left mr-1"></i>
        上一页
      </span>
    )}
    
    {/* 页码 */}
    {pages.map((page) => (
      page === 'ellipsis' ? (
        <span class="pagination-link disabled">...</span>
      ) : (
        page === currentPage ? (
          <span class="pagination-link active">
            【{getChineseNum(page)}】
          </span>
        ) : (
          <a href={getPageUrl(page)} class="pagination-link">
            {getChineseNum(page)}
          </a>
        )
      )
    ))}
    
    {/* 下一页 */}
    {hasNext ? (
      <a href={getPageUrl(currentPage + 1)} class="pagination-link">
        下一页
        <i class="ph ph-caret-right ml-1"></i>
      </a>
    ) : (
      <span class="pagination-link disabled">
        下一页
        <i class="ph ph-caret-right ml-1"></i>
      </span>
    )}
  </div>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  
  .pagination-link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    color: #5d5d5d;
    text-decoration: none;
    font-family: var(--font-hand);
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }
  
  .pagination-link:hover:not(.disabled) {
    color: #8b3a3a;
    background-color: rgba(139, 58, 58, 0.05);
  }
  
  .pagination-link.active {
    color: #8b3a3a;
    font-weight: bold;
    font-family: var(--font-calligraphy);
    font-size: 1rem;
  }
  
  .pagination-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
